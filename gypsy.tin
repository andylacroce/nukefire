#nop =====================================================
#nop GYPSY COMBAT
#nop Combat aliases and macros for gypsy class
#nop =====================================================

#nop ------------------ COMBAT ALIASES ------------------
#ALIAS {xx} {shoot mob burst}
#ALIAS {aaa} {#if {$lvl > 49}{sli 'rot'};shred}
#ALIAS {rr} {hyp mob;backstab mob;#if {$lvl > 44}{vtwist};#if {$lvl > 39}{bgrow};#if {$lvl > 14}{mysticveil};#if {$lvl > 34}{spiritr};#if {$lvl > 44}{impale}}

#nop ------------------ MACROS ------------------
#MACRO {-} {aaa}
#MACRO {=} {rr}
#MACRO {]} {hyp mob;disem mob;disem;disem}

#nop ------------------ SPELL / SKILL UTILITIES ------------------
#ALIAS {cb %1} {sli 'cure blind' %1}
#ALIAS {rc %1} {sli 'remove curse' %1}
#ALIAS {tarot_group} {group_targeted tarot}
#ALIAS {fa} {first %1}
#ALIAS {fam} {first $me}

#nop AFX - Check buffs and recast missing ones
#VARIABLE {has_voodoo} {0}
#VARIABLE {has_phantom} {0}
#VARIABLE {has_fortune} {0}

#action {You receive %1 experience points.} {
	#if {$lvl > 19} {rom};
	#if {$lvl > 39} {tarot_group};
}

#ACTION {^SPL: %* voodoo contract} {#variable {has_voodoo} {1}}
#ACTION {^SPL: %* phantom mirage} {#variable {has_phantom} {1}}
#ACTION {^SPL: %* fortune's blessing} {#variable {has_fortune} {1}}
#ACTION {TIMER: %*} {
	#delay {2} {
		#if {"%*" !~ "Gypsy_Dance" && $lvl > 19}{rom};
		#if {$has_voodoo == 0 && $lvl > 39}{sign};
		#if {$has_phantom == 0 && $lvl > 24}{mir};
		#if {$has_fortune == 0 && $lvl > 39}{tarot_group};
		#variable {has_voodoo} {0};
		#variable {has_phantom} {0};
		#variable {has_fortune} {0}
	}
}

#nop Fortune falls off messages
#ACTION {Fortune's blessing retreats from you.} {
	#variable {has_fortune} {0};
	#if {$lvl > 39}{tarot_group};
} 
#ACTION {The shimmer of Fortune's blessing fades from around %1.} {
	#var recaster %1;
	is_group_member %1;
	#if {$lvl > 39 && $igm_result == 1}{tarot_group};
} 

#nop ------------------ LEVEL-DRIVEN ACTIONS ------------------
#ACTION {[Regen]} {#if {$lvl > 39}{afx}}
#ACTION {The dance comes to a graceful end, as you posture and bow.} {rom}
#ACTION {The mirages fade away, leaving you exposed.} {mir}
#ACTION {Your Voodoo Contract has been broken, the hex dissipates.} {sign}
#ACTION {Your attempt to establish the Voodoo Contract fails.} {sign}

#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 15} {
			combo disem disem disem;
			#var {group_combo} {disem disem disem};
			groupassist_group;
		};
		#elseif {$lvl < 30} {
			combo mys mys mys;
			#var {group_combo} {mys mys mys};
			groupassist_group;
		};
		#elseif {$lvl < 45} {
			combo bgrow bgrow mys;
			#var {group_combo} {bgrow bgrow mys};
			groupassist_group;
		};
		#else {
			combo vtwist bgrow mys;
			#var {group_combo} {vtwist bgrow mys};
			groupassist_group;
		}
	}
}
