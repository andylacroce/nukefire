#nop =====================================================
#nop AUTOSTART
#nop =====================================================

#nop ------------------ SESSION ------------------
#read {nukefire/gmcp.tin};
#read {nukefire/map.tin};
#config {telnet} {on}

#session nukefire tdome.nukefire.org 4000
#action {What's your name, freejack?} {$me}
#action {Password:} {$password}
#action {*** PRESS RETURN:} {#send {}}
#action {Make your choice:} {#send {1}}

#nop ------------------ CLIENT SETUP ------------------
#delay {5} {
    #split;
    #format {ME_UPPER} {%u} {${me}};
    #screen set title {${ME_UPPER}};
    _map_init;
    logging_on;
    #delay {1} {
        afx;
        snapeq;
        sc;
    };
    #if {!$is_follower} {
        #delay {1} {group new}
    };
    #if {$is_follower} {
        #delay {2} {fol ${leader}}
    }
}