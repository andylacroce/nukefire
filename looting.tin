#nop =====================================================
#nop LOOTING & CONTAINERS
#nop =====================================================

#ALIAS {gc} {get all.credits;get credits all}
#ALIAS {ls} {look in $container}
#ALIAS {gg %1} {get %1 $container}
#ALIAS {ps %1} {put %1 $container}
#ALIAS {lc} {look in corpse;look in remains}
#ALIAS {x} {exam corpse;exam remains}
#ALIAS {gall} {get all all.corpse;get all all.remains}
#ALIAS {ret} {
    #if {"$me" == "Mutiny"} {
        retrieve;
        get all corpse;
        rewear;
        junk corpse;
        get all corpse;
        rewear;
        junk corpse;
        conceal dirk;conceal dagger;conceal knife;
        group new;
        n;u;
    };
    #if {"$me" == "Haenym"} {
        retrieve;
        get all corpse;
        rewear;
        junk corpse;
        get all corpse;
        rewear;
        junk corpse;
        n;u;
    };
    #if {"$me" == "Prodigy"} {
        retrieve;
        get all remains;
        rewear;
        junk remains;
        get all corpse;
        rewear;
        junk corpse;
        n;u;
    };
    #if {"$me" == "Rancor"} {
        retrieve;
        get all corpse;
        rewear;
        junk corpse;
        get all corpse;
        rewear;
        junk corpse;
        n;u;
    };
}
#ALIAS {gcr %1 %2} {give %1 credits %2}

#ACTION {credits is lying here.} {get all.credits}