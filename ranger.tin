#nop =====================================================
#nop RANGER COMBAT
#nop Combat aliases and macros for gypsy class
#nop =====================================================

#nop ------------------ DEFAULT TOGGLES ------------------
#VARIABLE {bark_on} {1}
#VARIABLE {catseye_on} {1}
#VARIABLE {autoheal_on} {1}
#VARIABLE {groupcheck_on} {1}



#nop ------------------ BARK SKIN REAPPLY ------------------
#class bark open
	#variable {has_bark} {0}

	#action {SPL: %* bark skin} {#variable {has_bark} {1}}
	#action {SPL: %* bark} {#variable {has_bark} {1}}
	#action {You invoke your bark skin, taking on a rough, tree-like appearance.} {#variable {has_bark} {1}}
	#action {The bark-like texture surrounding you fades away as you cease concentration.} {#variable {has_bark} {0};bark}
#class bark close

#nop ------------------ CATSEYE REAPPLY ------------------
#class catseye open
	#variable {has_catseye} {0}
	#action {SPL: %* catseye} {#variable {has_catseye} {1}}
#class catseye close

#alias {catseye_on} {
	#read {nukefire/ranger.tin};
	#class {catseye} {open};
	#var {catseye_on} {1};
	#showme {CATSEYE ON};
	#send {}
}
#alias {catseye_off} {
	#class {catseye} {clear};
	#var {catseye_on} {0};
	#showme {CATSEYE OFF};
	#send {}
}
#alias {ce} {
	#if {$catseye_on} {catseye_off} {catseye_on}
}

#alias {bark_on} {
	#read {nukefire/ranger.tin};
	#class {bark} {open};
	#var {bark_on} {1};
	#showme {BARK ON};
	#send {}
}
#alias {bark_off} {
	#class {bark} {clear};
	#var {bark_on} {0};
	#showme {BARK OFF};
	#send {}
}
#alias {bar} {
	#if {$bark_on} {bark_off} {bark_on}
}

#action {TIMER: %*} {
	#variable {has_bark} {0};
	#variable {has_catseye} {0};
	#delay {2} {
		#if {!$has_bark && $bark_on} {bark;#variable {has_bark} {1}};
		#if {!$has_catseye && $catseye_on} {sli 'catseye';#variable {has_catseye} {1}}
	}
}

#nop Group status ticker for autoheal
#class groupcheck open
	#var {groupcheck_on} {1}
	#TICKER {ranger_group_check} {gr} {3}
#class groupcheck close

#nop Auto-heal group members below 75% HP from group status output
#class autoheal open
	#action {[%1 %2] %3 %*: [%4/%5]H %* [%6/%7]V} {
		#math {target_hp_pct} {100 * %4 / %5};
		#if {$target_hp_pct < 75} {#if {$lvl > 15} {sli 'heal' %3} {#if {$lvl > 2} {sli 'cure light' %3}}};
	}
#class autoheal close

#alias {heal %1} {#if {$lvl > 15} {sli 'heal' %1} {#if {$lvl > 2} {sli 'cure light' %1}}}
#alias {healme} {#if {$lvl > 15} {sli 'heal' $me} {#if {$lvl > 2} {sli 'cure light' $me}}}

#nop ------------------ AUTOHEAL CONTROL ------------------
#alias {autoheal_on} {
	#read {nukefire/ranger.tin};
	#class {autoheal} {open};
	#var {autoheal_on} {1};
	#showme {Autoheal ON};
	#send {}
}
#alias {autoheal_off} {
	#class {autoheal} {clear};
	#var {autoheal_on} {0};
	#showme {Autoheal OFF};
	#send {}
}
#alias {autoheal} {
	#if {$autoheal_on} {autoheal_off} {autoheal_on}
}

#nop ------------------ GROUPCHECK CONTROL ------------------
#alias {groupcheck_on} {
	#read {nukefire/ranger.tin};
	#class {groupcheck} {open};
	#var {groupcheck_on} {1};
	#showme {Groupcheck ON};
	#send {}
}
#alias {groupcheck_off} {
	#class {groupcheck} {clear};
	#var {groupcheck_on} {0};
	#showme {Groupcheck OFF};
	#send {}
}
#alias {groupcheck} {
	#if {$groupcheck_on} {groupcheck_off} {groupcheck_on}
}

#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 9} {combo kick kick kick};
		#elseif {$lvl < 15}{combo bash bash bash};
        #elseif {$lvl < 20}{combo bush bush bush};
		#else {combo grapple grapple grapple}
	}
}