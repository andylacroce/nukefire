#nop =====================================================
#nop LOGGING
#nop =====================================================

#nop ------------------ LOGGING CONTROL ------------------
#variable {logging_on} {0}
#alias {logging_on} {
    #format {LOGTIME} {%t} {%Y-%m-%d_%H-%M-%S};
    #VARIABLE LOGFILE {nukefire/logs/nukefire_${me}_${LOGTIME}.log};
    #config {LOG} {PLAIN};
    #log append {${LOGFILE}};
    #var {logging_on} {1};
    #showme {Logging ON - writing to ${LOGFILE}};
    #send {}
}
#alias {logging_off} {
    #log off;
    #var {logging_on} {0};
    #showme {Logging OFF};
    #send {}
}
#alias {logging} {
    #if {$logging_on} {logging_off} {logging_on}
}
