#nop =====================================================
#nop LOGGING
#nop =====================================================

#class logging open
	#format {LOGTIME} {%t} {%Y-%m-%d_%H-%M-%S}
	#VARIABLE LOGFILE {nukefire/logs/nukefire_$me_$LOGTIME.log}
	#config {LOG} {PLAIN}
	#log append {$LOGFILE}
#class logging close

#nop ------------------ LOGGING CONTROL ------------------
#alias {logging_on} {
    #class {logging} {open};
    #format {LOGTIME} {%t} {%Y-%m-%d_%H-%M-%S};
    #VARIABLE LOGFILE {nukefire/logs/nukefire_$me_$LOGTIME.log};
    #config {LOG} {PLAIN};
    #log append {$LOGFILE};
    #class {logging} {close};
    #var {logging_on} {1};
    #showme {Logging ON - writing to $LOGFILE};
    #send {}
}
#alias {logging_off} {
    #log off;
    #class {logging} {clear};
    #var {logging_on} {0};
    #showme {Logging OFF};
    #send {}
}
#alias {logging} {
    #if {$logging_on} {logging_off} {logging_on}
}

#class {logging} {save}
