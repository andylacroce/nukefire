#nop =====================================================
#nop Haenym Profile
#nop =====================================================

#nop ------------------ CORE VARIABLES ------------------
#nop Keep variables first; actions/aliases depend on these.
#VARIABLE {me} {Haenym}
#VARIABLE {password} {REDACTED_PASSWORD}
#VARIABLE {lvl} {}
#VARIABLE {dest} {}
#VARIABLE {trackee} {}
#VARIABLE {container} {satchel}
#VARIABLE {remort_num} {933}
#nop Toggle: aloot / aloot_on / aloot_off
#VARIABLE {autoloot_on} {0}
#nop Toggle: logging / logging_on / logging_off
#VARIABLE {logging_on} {1}
#nop Toggle: tracking / tracking_on / tracking_off
#VARIABLE {tracking_on} {1}
#nop Class-specific module file (without .tin extension)
#VARIABLE {class} {curist}
#VARIABLE {class_module} {curist}

#nop ------------------ LOAD CHARACTER ------------------
#read {nukefire/char_load.tin}
