{
  "name": "nukefire-profiles",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "markdownlint-cli": "^0.49.1"
  },
  "scripts": {
    "lint:md": "npx markdownlint-cli README.md CONTRIBUTING.md",
    "lint:tin": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/check_tin_headers.ps1",
    "lint": "npm run lint:md && npm run lint:tin",
    "scan:secrets": "gitleaks detect --source . --config .gitleaks.toml --redact"
  }
}
