#nop =========================
#nop AUTOLOOT
#nop =========================

#class autoloot open
	#ACTION {credits is lying here.} {get all.credits}
	#ACTION {a puppet with severed strings.} {gall}
	#ACTION {a soul lost to the wasteland.} {gall}
	#ACTION {cacophony of the apocalypse.} {gall}
	#ACTION {collapses in a heap of metallic wreckage!} {gall}
	#ACTION {collapses into a pile of useless components.} {gall}
	#ACTION {cries are abruptly extinguished.} {gall}
	#ACTION {death looms closer.} {gall}
	#ACTION {echoing through the halls of doom!} {gall}
	#ACTION {emanates from} {gall}
	#ACTION {essence dissolving into the ether!} {gall}
	#ACTION {exposing bone!} {gall}
	#ACTION {flesh rots away!} {gall}
	#ACTION {grim lullaby for the damned.} {gall}
	#ACTION {its body going limp and lifeless.} {gall}
	#ACTION {its form going rigid and cold.} {gall}
	#ACTION {its internal systems irreparably damaged.} {gall}
	#ACTION {its lights dimming forever.} {gall}
	#ACTION {its parts scattering.} {gall}
	#ACTION {laid to rest beneath a Mystic Veil!} {gall}
	#ACTION {last utterance in this world.} {gall}
	#ACTION {marking the passing} {gall}
	#ACTION {power source irreversibly depletes.} {gall}
	#ACTION {powers down one last time.} {gall}
	#ACTION {ripped from this world.} {gall}
	#ACTION {sending shivers down your spine!} {gall}
	#ACTION {signaling its final malfunction.} {gall}
	#ACTION {soon to be forgotten.} {gall}
	#ACTION {tortured breaths.} {gall}
	#ACTION {voodoo doll has been broken.} {gall}
	#ACTION {winds of desolation.} {gall}
#class autoloot close

#nop ------------------ AUTOLOOT CONTROL ------------------
#alias {aloot_on} {
    #read {nukefire/autoloot.tin};
    #var {autoloot_on} {1};
    #showme {Autoloot ON};
    #send {}
}
#alias {aloot_off} {
    #class {autoloot} {clear};
    #var {autoloot_on} {0};
    #showme {Autoloot OFF};
    #send {}
}
#alias {aloot} {
    #if {$autoloot_on} {aloot_off} {aloot_on}
}

#class {autoloot} {save}