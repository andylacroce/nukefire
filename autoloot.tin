#nop =========================
#nop AUTOLOOT
#nop =========================

#class autoloot open
	#ACTION {a puppet with severed strings.} {gc}
	#ACTION {a soul lost to the wasteland.} {gc}
	#ACTION {cacophony of the apocalypse.} {gc}
	#ACTION {collapses in a heap of metallic wreckage!} {gc}
	#ACTION {collapses into a pile of useless components.} {gc}
	#ACTION {cries are abruptly extinguished.} {gc}
	#ACTION {death looms closer.} {gc}
	#ACTION {echoing through the halls of doom!} {gc}
	#ACTION {emanates from} {gc}
	#ACTION {essence dissolving into the ether!} {gc}
	#ACTION {exposing bone!} {gc}
	#ACTION {flesh rots away!} {gc}
	#ACTION {grim lullaby for the damned.} {gc}
	#ACTION {its body going limp and lifeless.} {gc}
	#ACTION {its form going rigid and cold.} {gc}
	#ACTION {its internal systems irreparably damaged.} {gc}
	#ACTION {its lights dimming forever.} {gc}
	#ACTION {its parts scattering.} {gc}
	#ACTION {laid to rest beneath a Mystic Veil!} {gc}
	#ACTION {last utterance in this world.} {gc}
	#ACTION {marking the passing} {gc}
	#ACTION {power source irreversibly depletes.} {gc}
	#ACTION {powers down one last time.} {gc}
	#ACTION {ripped from this world.} {gc}
	#ACTION {sending shivers down your spine!} {gc}
	#ACTION {signaling its final malfunction.} {gc}
	#ACTION {soon to be forgotten.} {gc}
	#ACTION {tortured breaths.} {gc}
	#ACTION {voodoo doll has been broken.} {gc}
	#ACTION {winds of desolation.} {gc}
	#ACTION {crimson testament to the fallen.} {gc}
	#ACTION {tragic tableau of demise.} {gc}
#class autoloot close
#if {!$autoloot_on} {#class {autoloot} {clear}}

#nop ------------------ AUTOLOOT CONTROL ------------------
#alias {aloot_on} {
	#var {autoloot_on} {1};
    #read {nukefire/autoloot.tin};
    #showme {Autoloot ON};
    #send {}
}
#alias {aloot_off} {
	#var {autoloot_on} {0};
    #class {autoloot} {clear};
    #showme {Autoloot OFF};
    #send {}
}
#alias {aloot} {
    #if {$autoloot_on} {aloot_off} {aloot_on}
}