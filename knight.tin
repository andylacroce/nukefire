#nop =====================================================
#nop Knight COMBAT
#nop Combat aliases and macros for Knight class
#nop =====================================================

#nop ------------------ CORE: STATE & HELPERS ------------------
#nop - Buff state trackers used by AFX routines
#nop - Manual group aliases (thin wrappers) rely on `cast_group` in `group.tin`
#VARIABLE {has_armor} {0}
#VARIABLE {has_barrier} {0}
#VARIABLE {has_war} {0}
#VARIABLE {has_honor} {0}

#nop ------------------ BASIC ALIASES ------------------
#alias {rec} {#if {lvl > 18} {sli 'word of recall'}}
#alias {heal %1} {#if {$lvl > 24} {sli 'heal' %1}}
#alias {healme} {#if {$lvl > 24} {sli 'heal' $me}}
#ACTION {$leader telepaths to you, 'heal'} {#if {$lvl > 24} {sli 'heal' $leader}}

#nop ------------------ MANUAL GROUP-CALL ALIASES ------------------
#ALIAS {armor_group} {cast_group armor 4}
#ALIAS {barrier_group} {cast_group barrier 24}
#ALIAS {war_group} {cast_group war 24}

#nop ------------------ AFX: SPELL LISTENERS & TIMER ------------------
#nop - SPL handlers mark when a buff is detected; TIMER periodically ensures buffs are present
#ACTION {^SPL: %* armor} {#variable {has_armor} {1}}
#ACTION {^SPL: %* barrier} {#variable {has_barrier} {1}}
#ACTION {^SPL: %* war} {#variable {has_war} {1}}
#ACTION {^SPL: %* honor} {#variable {has_honor} {1}}
#ACTION {TIMER: %*} {
	#delay {2} {
		#if {$has_armor == 0}{armor_group};
		#if {$has_barrier == 0}{barrier_group};
		#if {$has_war == 0}{war_group};
		#if {$has_honor == 0 && $lvl > 18}{sli 'honor' $me};
		#variable {has_armor} {0};
		#variable {has_barrier} {0};
		#variable {has_war} {0};
		#variable {has_honor} {0};
	}
}

#nop ------------------ FALL-OFF HANDLERS (AUTO-REAPPLY) ------------------
#nop - When a member loses a buff, reapply it to leader + followers using group aliases
#ACTION {You feel less protected.} {
	#variable {has_armor} {0};
	#if {$lvl > 4} {sli 'armor' $me};
};
#ACTION {%1 looks less protected.} {
	#var recaster %1;
	is_group_member %1;
	#if {$lvl > 4 && $igm_result == 1} {sli 'armor' %1;};
};  

#nop Barrier falls off messages
#ACTION {Your barrier of valor has gone limp.} {
	#variable {has_barrier} {0};
	#if {$lvl > 24} {sli 'barrier' $me};
};  
#ACTION {%1's barrier of valor slackens and fades.} {
	#var recaster %1;
	is_group_member %1;
	#if {$lvl > 24 && $igm_result == 1} {sli 'barrier' %1;};
};  

#nop War falls off messages
#ACTION {Your war banner has gone limp.} {
	#variable {has_war} {0};
	#if {$lvl > 24} {sli 'war' $me};
};  
#ACTION {%1's war banner goes limp.} {
	#var recaster %1;
	is_group_member %1;
	#if {$lvl > 24 && $igm_result == 1} {sli 'war' %1;};
};  

#nop ------------------ LEVEL-DRIVEN ACTIONS ------------------
#ACTION {[Regen]} {#if {$lvl > 4}{afx}}


#nop Group status ticker for autoheal and autoinvig
#class groupcheck open
	#var {groupcheck_on} {1}
	#TICKER {knight_group_check} {gr} {3}
#class groupcheck close

#nop Auto-heal group members below 75% HP from group status output
#class autoheal open
	#action {[%1 %2] %3 %*: [%4/%5]H %*} {
		#nop #showme {DEBUG: lvl=%1 class=%2 name=%3 hp=%4 maxhp=%5};
		#math {target_hp_pct} {100 * %4 / %5};
		#nop #showme {DEBUG: pct=$target_hp_pct};
		#if {$target_hp_pct < 85} {#if {$lvl > 24} {sli 'heal' %3}};
	}
#class autoheal close

#nop ------------------ AUTOHEAL CONTROL ------------------
#alias {autoheal_on} {
	#read {nukefire/knight.tin};
	#class {autoheal} {open};
	#var {autoheal_on} {1};
	#showme {Autoheal ON};
	#send {}
}
#alias {autoheal_off} {
	#class {autoheal} {clear};
	#var {autoheal_on} {0};
	#showme {Autoheal OFF};
	#send {}
}
#alias {autoheal} {
	#if {$autoheal_on} {autoheal_off} {autoheal_on}
}

#nop ------------------ GROUPCHECK CONTROL ------------------
#alias {groupcheck_on} {
	#read {nukefire/knight.tin};
	#class {groupcheck} {open};
	#var {groupcheck_on} {1};
	#showme {Groupcheck ON};
	#send {}
}
#alias {groupcheck_off} {
	#class {groupcheck} {clear};
	#var {groupcheck_on} {0};
	#showme {Groupcheck OFF};
	#send {}
}
#alias {groupcheck} {
	#if {$groupcheck_on} {groupcheck_off} {groupcheck_on}
}

#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 6} {
			combo kick kick kick;
			#var {group_combo} {kick kick kick};
			groupassist_group;
		};
		#elseif {$lvl < 15} {
			combo bash bash bash;
			#var {group_combo} {bash bash bash};
			groupassist_group;
		};
        #elseif {$lvl < 20} {
			combo flurry flurry flurry;
			#var {group_combo} {flurry flurry flurry};
			groupassist_group;
		};
		#else {
			combo grapple grapple grapple;
			#var {group_combo} {grapple grapple grapple};
			groupassist_group;
		}
	}
}