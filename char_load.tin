#nop =====================================================
#nop CHARACTER LOADER
#nop Generic module loading for all characters
#nop Expects: $class variable to be set in calling file
#nop =====================================================

#nop ------------------ LOAD ORDER NOTICE ------------------
#nop The order of reads below matters; do not reorder or remove
#nop modules unless you understand dependencies (class, role, etc.).
#nop ------------------ LEADER CONFIGURATION ------------------
#VARIABLE {leader} {Mutiny}
#list {followers} {create} {Haenym} {Prodigy} {Rancor}

#nop ------------------ DETERMINE CHARACTER ROLE ------------------
#variable {is_follower} {1}
#if {"${me}" == "${leader}"} {#variable {is_follower} {0}}

#nop ------------------ LEVEL TRACKING ------------------
#action {[Lvl %1, %2]} {
    #variable {lvl} {%1};
    #variable {exp_to_level} {%2};
}

#nop ------------------ LOAD GENERIC MODULES ------------------
#read {nukefire/looting.tin}
#read {nukefire/travel.tin}
#read {nukefire/tracking.tin}
#read {nukefire/materials.tin}
#read {nukefire/doors.tin}
#read {nukefire/remort.tin}
#read {nukefire/sleep.tin}
#read {nukefire/eq_mgmt.tin}
#read {nukefire/channels.tin}
#read {nukefire/group.tin}
#read {nukefire/autoloot.tin}
#read {nukefire/logging.tin}

#nop ------------------ LOAD CLASS-SPECIFIC MODULES ------------------
#nop Default no-op; healer classes override with group heal logic
#alias {_on_gmcp_group} {#nop}
#read {nukefire/class/${class}.tin}

#nop ------------------ LOAD ROLE-SPECIFIC MODULES ------------------
#if {$is_follower} {#read {nukefire/follower.tin}}
#if {!$is_follower} {#read {nukefire/leader.tin}}

#nop ------------------ AUTOSTART ------------------
#read {nukefire/autostart.tin}
