#nop =====================================================
#nop TRACKING
#nop =====================================================

#nop ------------------ RECON TRACKING MESSAGES ------------------
#alias {ato} {tel prodigy o autotrack}
#alias {at %1} {tel prodigy o autotrack %1}
#action {Prodigy telepaths to you, 'The target, %*, is %2.'} {%2} {2}

#nop ------------------ RECON TRACKING ALIASES ------------------
#ALIAS {trk %1} {#variable trackee %1;track $trackee}
#ALIAS {untrk} {#variable trackee $me}

#nop ------------------ RECON TRACKING ACTIONS ------------------
#nop Guard: only fire when tracking is on and trackee is not self

#track was successful
#ACTION {%* trail leads %1.} {#if {$tracking_on && "$trackee" != "$me"} {%1;track $trackee}}
#ACTION {The trail of %* leads %1 from here.} {#if {$tracking_on && "$trackee" != "$me"} {%1;track $trackee}}

#track was unsuccessful
#action {%* trail seems to lead %*} {#if {$tracking_on && "$trackee" != "$me"} {track $trackee}}
#action {The trail seems to bend %*} {#if {$tracking_on && "$trackee" != "$me"} {track $trackee}}

#track is complete
#ACTION {You are already with} {#if {$tracking_on && "$trackee" != "$me"} {untrk}}
#ACTION {You are already standing in the same place as} {#if {$tracking_on && "$trackee" != "$me"} {untrk}}

#nop ------------------ TRACKING CONTROL ------------------
#variable {tracking_on} {1}

#alias {tracking_on} {
    #var {tracking_on} {1};
    #showme {Tracking ON};
    #send {}
}
#alias {tracking_off} {
    #var {tracking_on} {0};
    #showme {Tracking OFF};
    #send {}
}
#alias {tracking} {
    #if {$tracking_on} {tracking_off} {tracking_on}
}
