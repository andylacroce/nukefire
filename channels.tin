#nop =====================================================
#nop COMMUNICATION CHANNELS
#nop Channel commands and history tracking
#nop =====================================================

#nop ------------------ GOSSIP LOG ------------------
#ACTION {%*gossips, %*} {_leader_log {nukefire/logs/gossip.log} {%1} {%0}}
#ACTION {%*You gossip, %*} {
    #if {!${is_follower}} {
        #variable {_chlog_ok} {1};
        #regexp {%1} {^\s*\d} {#variable {_chlog_ok} {0}};
        #regexp {%0} {^\d} {#variable {_chlog_ok} {0}};
        #if {${_chlog_ok}} {_ch_log {nukefire/logs/gossip.log} {[${me}] %0}}
    }
}

#nop ------------------ TELEPATH LOG ------------------
#ACTION {You telepath %*, %*} {
    #variable {_chlog_ok} {1};
    #regexp {%0} {^\d} {#variable {_chlog_ok} {0}};
    #if {${_chlog_ok}} {#list {followers} {find} {%1} {_idx}};
    #if {${_chlog_ok} && ${_idx} > 0} {#variable {_chlog_ok} {0}};
    #if {${_chlog_ok} && "%1" == "${leader}"} {#variable {_chlog_ok} {0}};
    #if {${_chlog_ok}} {_ch_log {nukefire/logs/telepath.log} {[${me}] %0}}
}
#ACTION {%* telepaths to you, %*} {
    #variable {_chlog_ok} {1};
    #regexp {%1} {^\d} {#variable {_chlog_ok} {0}};
    #if {${_chlog_ok}} {#list {followers} {find} {%1} {_idx}};
    #if {${_chlog_ok} && ${_idx} > 0} {#variable {_chlog_ok} {0}};
    #if {${_chlog_ok} && "%1" == "${leader}"} {#variable {_chlog_ok} {0}};
    #if {${_chlog_ok}} {_ch_log {nukefire/logs/telepath.log} {[${me}] %0}}
}

