#nop =====================================================
#nop COMMUNICATION CHANNELS
#nop Channel commands and history tracking
#nop =====================================================

#nop ------------------ GOSSIP LOG ------------------
#ACTION {%*gossips, %*} {
    #if {!${is_follower}} {
        #var {_log_this} {1};
        #regexp {%1} {^\d} {#var {_log_this} {0}};
        #if {${_log_this}} {
            #format {_ts} {%t} {%m/%d %H:%M};
            #line log {nukefire/logs/gossip.log} {[${_ts}] %0}
        }
    }
}
#ACTION {You gossip, %*} {
    #if {!${is_follower}} {
        #var {_log_this} {1};
        #regexp {%0} {^\d} {#var {_log_this} {0}};
        #if {${_log_this}} {
            #format {_ts} {%t} {%m/%d %H:%M};
            #line log {nukefire/logs/gossip.log} {[${_ts}] %0}
        }
    }
}

#nop ------------------ TELEPATH LOG ------------------
#ACTION {You telepath %*, %*} {
    #var {_log_this} {1};
    #regexp {%0} {^\d} {#var {_log_this} {0}};
    #if {${_log_this}} {#list {followers} {find} {%1} {_idx}};
    #if {${_log_this} && ${_idx} > 0} {#var {_log_this} {0}};
    #if {${_log_this} && "%1" == "${leader}"} {#var {_log_this} {0}};
    #if {${_log_this}} {#format {_ts} {%t} {%m/%d %H:%M};
        #line log {nukefire/logs/telepath.log} {[${_ts}] [${me}] %0}}
}
#ACTION {%* telepaths to you, %*} {
    #var {_log_this} {1};
    #regexp {%1} {^\d} {#var {_log_this} {0}};
    #if {${_log_this}} {#list {followers} {find} {%1} {_idx}};
    #if {${_log_this} && ${_idx} > 0} {#var {_log_this} {0}};
    #if {${_log_this} && "%1" == "${leader}"} {#var {_log_this} {0}};
    #if {${_log_this}} {#format {_ts} {%t} {%m/%d %H:%M};
        #line log {nukefire/logs/telepath.log} {[${_ts}] [${me}] %0}}
}

