#nop ------------------ GROUP LOG ------------------
#ACTION {\[Group\] %* says, %*} {_leader_log {nukefire/logs/group.log} {%1} {%0}}
#ACTION {%*You group-say, %*} {
    #if {!${is_follower}} {
        #variable {_chlog_ok} {1};
        #regexp {%1} {^\s*\d} {#variable {_chlog_ok} {0}};
        #regexp {%0} {^\d} {#variable {_chlog_ok} {0}};
