#nop ------------------ BROADCAST LOG (Glory / New Item) ------------------
#ACTION {\[GLORY\] %*} {_leader_log {nukefire/logs/broadcast.log} {%1} {%0}}
#ACTION {\[ NEW ITEM EVENT \] %*} {_leader_log {nukefire/logs/broadcast.log} {%1} {%0}}
#ACTION {\[CLASS REMORT EVENT\] %*} {_leader_log {nukefire/logs/broadcast.log} {%1} {%0}}
#ACTION {\[Class Legacy\] %*} {_leader_log {nukefire/logs/broadcast.log} {%1} {%0}}
#ACTION {\[ NUKEFIRE MUDVAULT \] %*} {_leader_log {nukefire/logs/broadcast.log} {%1} {%0}}
#ACTION {Skynet\(TM\) %*} {
    #if {!${is_follower}} {
        #variable {_chlog_ok} {1};
        #regexp {%1} {^\d} {#variable {_chlog_ok} {0}};
        #regexp {%1} {linked destinations} {#variable {_chlog_ok} {0}};
        #if {${_chlog_ok}} {_ch_log {nukefire/logs/broadcast.log} {%0}}
    }
}

