#nop =====================================================
#nop LEADER UTILITIES
#nop Leader aliases, actions, and remort helpers
#nop =====================================================

#nop ------------------ ACTIONS ------------------
#action {Body recovery complete...} {
    #delay {3} {group new};
}

#nop ------------------ ALIASES ------------------
#macro {[} {
    hyp mob;
    backstab mob;
    whisper rancor o stalk mob;
    #if {$lvl > 49} {sli 'rot'};
    #elseif {$lvl > 39} {shred};
    whisper prodigy o chain;
    whisper rancor o rage;
    whisper haenym hellquake;
    #if {$lvl > 39} {shred};
}

#macro {]} {
    whisper rancor o stalk mob;
    whisper prodigy o chain;
    whisper rancor o rage;
    whisper haenym hellquake;
}

#alias {otf %*} {
    #foreach {$followers[%*]} {follower} {
        #if {"$follower" != "$me"} {tel $follower o %1};
    };
}

#alias {ow %*} {
    #foreach {$followers[%*]} {follower} {
        #if {"$follower" != "$me"} {whisper $follower o %1};
    };
}

#alias {sum %1} {
    whisper haenym o sum %1;
}

#alias {silv} {
    ow gather silver;
    ow give all.silver ${leader};
}

#alias {cred} {
    ow cred;
}

#alias {gam} {
    ow give all mutiny;silv;cred;
}

#alias {seq} {
    otf seq;
    snap_store;
}

#alias {sc} {
    otf dps;
    otf sc;
    dps;
    score;
}

#alias {af} {
    otf afx;
    afx;
}

#ALIAS {esc} {
    tel haenym o esc;
}

#ALIAS {rec} {
    #if {!$is_follower} {
        #foreach {$followers[%*]} {follower} {
            #if {"$follower" != "$me"} {tel $follower o recall};
        };
    };
    recall;
}

#ALIAS {come} {
    #if {!$is_follower} {
        #foreach {$followers[%*]} {follower} {
            #if {"$follower" != "$me"} {tel $follower o trk ${leader}};
        };
    };
}

#nop ------------------ REMORT ACTIONS ------------------
#action {%1 whispers to you, 'remort cost: %2 credits'} {
	gcr %2 %1;
    whisper %1 o mort;
}

#action {%1 whispers to you, 'remort needs: %2 silver discs'} {
    gather silver;
    give %2 silver %1;
    am;
    whisper %1 o mort;
}

#action {But this will cost you %1 credits!!} {
	with %1;
    mort;
}

#nop ------------------ OTHER ACTIONS ------------------

#action {[ Remorts:    %1 ]} {
	#variable {total_remorts} {%1};
	#replace {total_remorts} {{^[ ]+}} {};
}

#action {best rolling %1} {
	#variable {dps} {%1};
}

#action {[ Class Remorts:]\n%*\n} {
	#variable {class_remorts} {%1}; 
	#replace {class_remorts} {{ }} {};
	#delay {.5} {#showme {\e]P40000AA <048>Lvl: $lvl || $exp_to_level || Class Remorts: $class_remorts || Total Remorts: $total_remorts || DPS: $dps}};
}