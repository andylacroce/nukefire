#action {Body recovery complete...} {
    #delay {3} {group new};
}

#alias {otf %*} {
    #var i 1;
    #while {$i <= &followers[]} {
        #list followers get $i follower;
        #if {"$follower" != "$me"} {tel $follower o %1};
        #math i $i + 1;
    };
}

#alias {seq} {
    otf seq;
    snap_store;
}

#alias {sc} {
    otf sc;
    score;
}

#alias {af} {
    otf afx;
    afx;
}

#ALIAS {esc} {
    tel haenym o esc;
}

#ALIAS {rec} {
    #if {!$is_follower} {
        #var i 1;
        #while {$i <= &followers[]} {
            #list followers get $i follower;
            tel $follower o recall;
            #math i $i + 1;
        };
    };
    recall;
}

#nop ------------------ REMORT ACTIONS ------------------
#action {%1 telepaths to you, 'remort cost: %2 credits'} {
	with %2;
	gcr %2 %1;
    tel %1 o mort;
}

#action {%1 telepaths to you, 'remort needs: %2 silver discs'} {
    gather silver;
    give %2 silver %1;
    am;
    tel %1 o mort;
}