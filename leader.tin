#alias {otf %*} {
    #var i 1;
    #while {$i <= &followers[]} {
        #list followers get $i follower;
        #if {"$follower" != "$me"} {tel $follower o %1};
        #math i $i + 1;
    };
}

#alias {seq} {
    otf snapeq;
    snapeq;
}

#alias {sc} {
    otf sc;
    score;
}

#alias {af} {
    otf afx;
    afx;
}

#ALIAS {esc} {
    tel haenym o esc;
}

#ALIAS {rec} {
    #if {!$is_follower} {
        #var i 1;
        #while {$i <= &followers[]} {
            #list followers get $i follower;
            tel $follower o recall;
            #math i $i + 1;
        };
    };
    recall;
}