#nop =====================================================
#nop LEADER UTILITIES
#nop Leader aliases, actions, and remort helpers
#nop =====================================================

#nop ------------------ ACTIONS ------------------
#action {Body recovery complete...} {
    #delay {3} {group new};
}

#nop ------------------ ALIASES ------------------
#macro {[} {
    hyp mob;
    backstab mob;
    whisper rancor o stalk mob;
    #if {$lvl > 49} {sli 'rot'};
    #elseif {$lvl > 39} {shred};
    whisper prodigy o chain;
    whisper rancor o rage;
    whisper haenym o hellquake;
    #if {$lvl > 39} {shred};
}

#macro {]} {
    whisper rancor o stalk mob;
    whisper prodigy o chain;
    whisper rancor o rage;
    whisper haenym o hellquake;
}

#alias {otf %*} {
    #var i 1;
    #while {$i <= &followers[]} {
        #list followers get $i follower;
        #if {"$follower" != "$me"} {whisper $follower o %1};
        #math i $i + 1;
    };
}

#alias {ow %*} {
    #var i 1;
    #while {$i <= &followers[]} {
        #list followers get $i follower;
        #if {"$follower" != "$me"} {whisper $follower o %1};
        #math i $i + 1;
    };
}

#alias {silv} {
    ow gather silver;
    ow give all.silver ${leader};
}

#alias {cred} {
    ow cred;
}

#alias {gam} {
    ow give all mutiny;silv;cred;
}

#alias {seq} {
    otf seq;
    snap_store;
}

#alias {sc} {
    otf sc;
    score;
}

#alias {af} {
    otf afx;
    afx;
}

#ALIAS {esc} {
    tel haenym o esc;
}

#ALIAS {rec} {
    #if {!$is_follower} {
        #var i 1;
        #while {$i <= &followers[]} {
            #list followers get $i follower;
            tel $follower o recall;
            #math i $i + 1;
        };
    };
    recall;
}

#nop ------------------ REMORT ACTIONS ------------------
#action {%1 whispers to you, 'remort cost: %2 credits'} {
	gcr %2 %1;
    whisper %1 o mort;
}

#action {%1 whispers to you, 'remort needs: %2 silver discs'} {
    gather silver;
    give %2 silver %1;
    am;
    whisper %1 o mort;
}

#action {But this will cost you %1 credits!!} {
	with %1;
    mort;
}

#nop ------------------ OTHER ACTIONS ------------------

#action {[ Remorts:    %1 ]} {
	#variable {total_remorts} {%1};
	#replace {total_remorts} {{^[ ]+}} {};
}

#action {[ Class Remorts:]\n%*\n} {
	#variable {class_remorts} {%1}; 
	#replace {class_remorts} {{ }} {};
	#delay {.5} {#showme {\e]P40000AA <048>Lvl: $lvl || $exp_to_level || Class Remorts: $class_remorts || Total Remorts: $total_remorts}}
}