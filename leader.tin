#nop =====================================================
#nop LEADER UTILITIES
#nop Leader aliases, actions, and remort helpers
#nop =====================================================

#nop ------------------ ACTIONS ------------------
#action {Body recovery complete...} {
    #delay {3} {group new};
}

#nop ------------------ ALIASES ------------------
#macro {[} {
    hyp mob;
    whisper rancor o stalk mob;
    #if {$lvl > 49} {sli 'rot'};
    #elseif {$lvl > 39} {shred};
    whisper rancor o rage;
    whisper prodigy o chain;
    whisper haenym o hellquake;
    #if {$lvl > 39} {shred};
}

#macro {]} {
    whisper rancor o stalk mob;
    whisper rancor o rage;
    whisper prodigy o chain;
    whisper haenym o hellquake;
}

#alias {otf %*} {
    #foreach {$followers[%*]} {follower} {
        #if {"$follower" != "$me"} {tel $follower o %1};
    };
}

#alias {ow %*} {
    #foreach {$followers[%*]} {follower} {
        #if {"$follower" != "$me"} {whisper $follower o %1};
    };
}

#alias {sum %1} {
    whisper haenym o sum %1;
}

#alias {wran} {
    #foreach {$followers[%*]} {follower} {
        #if {"$follower" != "$me"} {wrangle $follower};
    };
}

#alias {as} {aucst 1;otf aucstat 1}

#alias {silv} {
    ow gather silver;
    ow give all.silver ${leader};
}

#alias {cred} {
    ow cred;
}

#alias {gam} {
    sc;#delay {.5} {ow give all ${leader};silv;cred};
}

#alias {seq} {
    ow snapeq;
    snapeq;
}

#alias {sc} {
    ow dps;
    ow sc;
    dps;
    score;
}

#alias {af} {
    ow afx;
    afx;
}

#ALIAS {esc} {
    tel haenym o esc;
}

#ALIAS {rec} {
    gam;
    #if {!$is_follower} {
        map_save;
        #foreach {$followers[%*]} {follower} {
            #if {"$follower" != "$me"} {tel $follower o recall};
        };
    };
    recall;
    #delay {1} {
        bal;
        #delay {1} {#math run_total {$bank_balance - $last_balance}; #showme {Run Total: \$$run_total}};
    }
}

#ALIAS {come} {
    #if {!$is_follower} {
        #foreach {$followers[%*]} {follower} {
            #if {"$follower" != "$me"} {tel $follower o trk ${leader}};
        };
    };
}

#nop ------------------ REMORT ACTIONS ------------------
#action {%1 whispers to you, 'remort cost: %2 credits'} {
	gcr %2 %1;
    whisper %1 o mort;
}

#action {%1 whispers to you, 'remort needs: %2 silver discs'} {
    gather silver;
    give %2 silver %1;
    am;
    whisper %1 o mort;
}

#action {But this will cost you %1 credits!!} {
	with %1;
    mort;
}

#nop ------------------ OTHER ACTIONS ------------------

#action {[ Remorts:    %1 ]} {
	#variable {total_remorts} {%1};
	#replace {total_remorts} {{^[ ]+}} {};
}

#action {best rolling %1} {
	#variable {dps} {%1};
}

#action {[ Class Remorts:]\n%*\n} {
	#variable {class_remorts} {%1};
	#replace {class_remorts} {{ }} {};
	#line log {nukefire/logs/remorts_${me}.log} {${class_remorts}};
	#delay {.5} {#showme {\e]P40000AA <048>Lvl: $lvl || $exp_to_level || Class Remorts: $class_remorts || Total Remorts: $total_remorts || DPS: $dps}};
}

#action {[BANK] Your balance: %1 credits.} {
    #variable {bank_balance} {%1};
}