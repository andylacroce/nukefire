#nop =====================================================
#nop LEADER UTILITIES
#nop Leader aliases, actions, and remort helpers
#nop =====================================================

#nop ------------------ ACTIONS ------------------
#action {Body recovery complete...} {
    #delay {3} {group new};
}

#nop ------------------ ALIASES ------------------
#alias {_kill_engage} {
    #variable {_ak_fn} {_kill_engage};
    #if {$lvl > 49} {sli 'rot'};
    #elseif {$lvl > 39} {shred};
    tel rancor o rage;
    tel prodigy o chain;
    tel haenym o hellquake;
    #if {$lvl > 39} {shred};
    resc rancor;
}

#macro {[} {_kill_engage}

#alias {_rr_engage} {
    #variable {_ak_fn} {_rr_engage};
    rr;
}

#macro {=} {_rr_engage}

#macro {]} {
    tel rancor o stalk mob;
    tel rancor o rage;
    tel prodigy o chain;
    tel haenym o hellquake;
}

#alias {otf %*} {
    #foreach {$followers[%*]} {follower} {
        #if {"$follower" != "$me"} {tel $follower o %1};
    };
}

#alias {sum %1} {
    tel haenym o sum %1;
}

#alias {wran} {
    #foreach {$followers[%*]} {follower} {
        #if {"$follower" != "$me"} {wrangle $follower};
    };
}

#alias {as} {aucst 1;otf aucstat 1}

#alias {silv} {
    otf gather silver;
    otf give all.silver ${leader};
}

#alias {cred} {
    otf cred;
}

#alias {gam} {
    sc;#delay {.5} {otf give all ${leader};silv;cred};
}

#alias {seq} {
    otf snapeq;
    snapeq;
}

#alias {sc} {
    otf dps;
    otf sc;
    bal;
    dps;
    score;
}

#alias {af} {
    otf afx;
    afx;
}

#ALIAS {esc} {
    tel haenym o esc;
}

#ALIAS {rec} {
    gam;
    #if {!$is_follower} {
        map_save;
        #foreach {$followers[%*]} {follower} {
            #if {"$follower" != "$me"} {tel $follower o recall};
        };
    };
    recall;
    #delay {1} {
        bal;
        exp_reset;
        otf exp_reset;
        #delay {1} {#math run_total {$bank_balance - $last_balance}; #showme {Run Total: \$$run_total}};
    }
}

#ALIAS {come} {
    rally set;
    #DELAY {.5} {
        #if {!$is_follower} {
            #foreach {$followers[%*]} {follower} {
                #if {"$follower" != "$me"} {tel $follower o rd};
            };
        };
    #delay {3} {rc};
    }
}

#alias {rc} {
    rally clear;
}

#nop ------------------ REMORT ACTIONS ------------------
#action {%1 telepaths to you, 'remort cost: %2 credits'} {
	gcr %2 %1;
    tel %1 o mort;
} {2}

#action {%1 telepaths to you, 'remort needs: %2 silver discs'} {
    gather silver;
    give %2 silver %1;
    am;
    tel %1 o mort;
} {2}

#action {But this will cost you %1 credits!!} {
	with %1;
    mort;
}

#nop ------------------ OTHER ACTIONS ------------------

#action {[ Remorts:    %1 ]} {
	#variable {total_remorts} {%1};
	#replace {total_remorts} {{^[ ]+}} {};
}

#action {best rolling %1} {
	#variable {dps} {%1};
}

#action {[ Class Remorts:]\n%*\n} {
	#variable {class_remorts} {%1};
	#replace {class_remorts} {{ }} {};
	#line log {nukefire/logs/remorts_${me}.log} {${class_remorts}};
	#delay {.5} {_report_status};
}

#action {[BANK] Your balance: %1 credits.} {
    #variable {bank_balance} {%1};
    #line log {nukefire/logs/balance.log} {%1};
}
#action {:    %1  (keyword: silverdisc)} {
    #var sd_tmp {%1};
    #replace {sd_tmp} { } {};
    #line log {nukefire/logs/silverdisc.log} {$sd_tmp};
}
#action {[BANK] %*deposits %* credits.} {bal}
#action {[BANK] You don't have any credits to deposit.} {bal}
#alias {mat} {
    #line log {nukefire/logs/silverdisc.log} {0};
    mater;
}
#action {You have added materials:} {mat}

#nop ------------------ AUTO-KILL LOOP ------------------
#variable {autokill_on}          {1}
#variable {_ak_fn}               {_kill_engage}
#variable {_ak_last_enemy_count} {0}
#variable {_ak_pending}          {0}

#alias {autokill_on} {
    #variable {autokill_on}          {1};
    #variable {_ak_last_enemy_count} {0};
    #variable {_ak_pending}          {0};
    #showme {Autokill ON};
    #send {}
}
#alias {autokill_off} {
    #variable {autokill_on} {0};
    #variable {_ak_pending} {0};
    #showme {Autokill OFF};
    #send {}
}
#alias {autokill} {#if {$autokill_on} {autokill_off} {autokill_on}}
#alias {ak} {autokill}

#alias {_on_gmcp_group} {
    #if {!$autokill_on} {#return};
    #local _ec {0};
    #local _ei {1};
    #while {"$gmcp[group][enemies][$_ei][name]" != ""} {
        #math _ec {$_ec + 1};
        #math _ei {$_ei + 1};
    };
    #if {$_ak_last_enemy_count > 0 && $_ec == 0 && !$_ak_pending} {
        #variable {_ak_pending} {1};
        #delay {1.5} {
            #variable {_ak_pending} {0};
            #if {$_ak_last_enemy_count == 0} {
                $_ak_fn;
            };
        };
    };
    #variable {_ak_last_enemy_count} {$_ec};
}