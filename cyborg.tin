#nop =====================================================
#nop CYBORG COMBAT
#nop Combat aliases and macros for cyborg class
#nop =====================================================

#nop ------------------ LEVEL-DRIVEN ACTIONS ------------------
#ACTION {[Regen]} {afx}

#nop ------------------ SPELL / SKILL UTILITIES ------------------

#nop Damcon toggle class
#class dcon open
	#variable {has_damcon} {0}
	
    #action {SPL: %* damcon} {#variable {has_damcon} {1}}
    
    #action {The //DAMCON\\\\ status light blinks on.} {#variable {has_damcon} {1}}
    #action {The //DAMCON\\\\ status light blinks off.} {#variable {has_damcon} {0};damcon}
#class dcon close

#nop ------------------ DAMCON CONTROL ------------------
#alias {dcon_on} {
	#read {nukefire/cyborg.tin};
	#class {dcon} {open};
	#var {dcon_on} {1};
	#showme {DCON ON};
	#send {}
}
#alias {dcon_off} {
	#class {dcon} {clear};
	#var {dcon_on} {0};
	#showme {DCON OFF};
	#send {}
}
#alias {dcon} {
	#if {$dcon_on} {dcon_off} {dcon_on}
}

#nop ------------------ TURBO CONTROL ------------------

#nop Turbo requires level > 10 to use/auto-cast
#class turbo open
	#variable {has_turbo} {0}
	
    #action {SPL: %* turbo} {#variable {has_turbo} {1}}
    
    #action {The //TURBO\\\\ status light blinks blinks on in your vision field.} {#variable {has_turbo} {1}}
    #action {The //TURBO\\\\ status light blinks off.\nThe //TURBO\\\\ status light blinks off.} {#variable {has_turbo} {0};turbo}
#class turbo close

#alias {turbo_on} {
	#read {nukefire/cyborg.tin};
	#class {turbo} {open};
	#var {turbo_on} {1};
	#showme {TURBO ON};
	#send {}
}
#alias {turbo_off} {
	#class {turbo} {clear};
	#var {turbo_on} {0};
	#showme {TURBO OFF};
	#send {}
}
#alias {tur} {
	#if {$turbo_on} {turbo_off} {turbo_on}
}

#action {TIMER: %*} {
    #variable {has_damcon} {0};
    #variable {has_turbo} {0};
    #delay {2} {
        #if {!$has_damcon && $dcon_on} {damcon;#variable {has_damcon} {1}};
        #if {$lvl > 9} {
            #if {!$has_turbo && $turbo_on} {turbo;#variable {has_turbo} {1}}
        }
    }
    
}

#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 3} {
			combo kick kick kick;
			#var {group_combo} {kick kick kick};
			groupassist_group;
		};
		#elseif {$lvl < 13} {
			combo bash bash bash;
			#var {group_combo} {bash bash bash};
			groupassist_group;
		};
		#elseif {$lvl < 35} {
			combo pound pound pound;
			#var {group_combo} {pound pound pound};
			groupassist_group;
		};
		#elseif {$lvl < 40} {
			combo neur neur neur;
			#var {group_combo} {neur neur neur};
			groupassist_group;
		};
		#else {
			combo nano neur neur;
			#var {group_combo} {nano neur neur};
			groupassist_group;
		};
	}
}