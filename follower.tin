#nop =====================================================
#nop FOLLOWER UTILITIES
#nop Auto-follow and group management for followers
#nop =====================================================

#alias {seq} {snap_store;}

#nop ------------------ LEADER PRESENCE CHECK ------------------
#nop Detect if leader is in room — tel them and retry `look` when absent
#nop Reset leader presence flag at start of room (room title line like "The stairway - [Inside]")
#action {^%* - \[%*} {
	#variable {leader_here} {0};
}

#nop Detect a leader line such as "[Leader  44]Mutiny is standing here."
#nop Uses the ${leader} variable so it works for any leader name
#action {^\[Leader %*\]${leader} %*} {
	#variable {leader_here} {1};
}
#action {^\[Leader %*\]A whirling blur is here.} {
	#variable {leader_here} {1};
}
#action {^\[Leader %*\]A big muscular beast is standing here.} {
	#variable {leader_here} {1};
}
#action {^\[Leader %*\]A big muscular beast is here} {
	#variable {leader_here} {1};
}

#nop After the room listing ends (when "Obvious exits:" is printed), act based on whether leader was seen
#class leader_presence open
	#var {leader_presence_on} {1}
	#action {^Obvious exits:} {
		#if ($leader_here) {
			#variable {leader_here} {0};
		};
		#else {
			tel ${leader} not here...;
			#delay {10} {look};
		}
	}
#class leader_presence close
#if {!$leader_presence_on} {#class {leader_presence} {clear}}

#alias {leader_presence_on} {
	#class {leader_presence} {open};
	#action {^Obvious exits:} {
		#if ($leader_here) {
			#variable {leader_here} {0};
		};
		#else {
			tel ${leader} not here...;
			#delay {10} {look};
		}
	};
	#class {leader_presence} {close};
	#var {leader_presence_on} {1};
	#showme {Leader presence ON};
	#send {}
}
#alias {leader_presence_off} {
	#class {leader_presence} {clear};
	#var {leader_presence_on} {0};
	#showme {Leader presence OFF};
	#send {}
}
#alias {leader_presence} {
	#if {$leader_presence_on} {leader_presence_off} {leader_presence_on}
}

#nop --- Short aliases ---
#alias {lp_on} {leader_presence_on}
#alias {lp_off} {leader_presence_off}
#alias {lp} {leader_presence}

#nop ------------------ FOLLOW STATUS TRACKING ------------------
#nop Not in group - auto-follow
#ACTION {^You must specify a group option, or type HELP GROUP for more info.} {
	tel ${leader} not grouped, trying to follow;
	fol ${leader}
}

#nop Leader not in room - just notify
#ACTION {^No freejack by that name here, punk.} {
	tel ${leader} not in room, waiting for you
}

#ACTION {You're already in the same room as ${leader}!} {
	tel ${leader} I'm here now!;
	untrk;
}

#nop ------------------ AUTO-CHECK GROUP STATUS ------------------
#TICKER {group_check} {l;gr} {15}

#nop ------------------ LEADER ACTIONS ------------------
#action {${leader}'s form shimmers with eldritch power as he vanishes beyond mortal planes!} {recall}
#action {${leader} telepaths to you, 'o %*'} {%1}
#action {${leader} whispers to you, 'o %*'} {%1}

#action {[ Remorts:    %1 ]} {
	#variable {total_remorts} {%1};
	#replace {total_remorts} {{^[ ]+}} {};
}

#action {[ Class Remorts:]\n%*\n} {
	#variable {class_remorts} {%1}; 
	#replace {class_remorts} {{ }} {};
	#delay {.5} {whisper ${leader} @BLvl: $lvl || $exp_to_level || Class Remorts: $class_remorts || Total Remorts: $total_remorts;}
}

#nop ------------------ REMORT ACTIONS ------------------
#action {But this will cost you %1 credits!!} {
	whisper ${leader} remort cost: %1 credits
}

#action {The Remorter tells you, 'You need %1 silver discs in order to remort now.'} {
	whisper ${leader} remort needs: %1 silver discs
}

#action {The Remorter tells you, 'There you are, kid.'} {
	whisper ${leader} remort complete
}

#alias {cred} {
	give $total_credits credits ${leader};
}