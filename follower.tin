#nop =====================================================
#nop FOLLOWER UTILITIES
#nop Auto-follow and group management for followers
#nop =====================================================

#nop ------------------ FOLLOW STATUS TRACKING ------------------
#nop Not in group - auto-follow
#ACTION {^You must specify a group option, or type HELP GROUP for more info.} {
	tel ${leader} not grouped, trying to follow;
	fol ${leader}
}

#nop Leader not in room - just notify
#ACTION {^No freejack by that name here, punk.} {
	tel ${leader} not in room, waiting for you
}

#nop ------------------ AUTO-CHECK GROUP STATUS ------------------
#TICKER {group_check} {gr} {15}

#nop ------------------ LEADER ACTIONS ------------------
#action {${leader}'s form shimmers with eldritch power as he vanishes beyond mortal planes!} {recall}
#action {${leader} telepaths to you, 'o %*'} {%1}

#action {[Saved your re-wear script.]} {tel ${leader} eq snapped}

#action {[ Class Remorts:]\n%*\n} {
	#variable {class_remorts} {%1}; 
	tel ${leader} Lvl: $lvl, Exp to Next: $exp_to_level, Class Remorts: $class_remorts;
}