#nop =====================================================
#nop CURIST COMBAT
#nop Combat aliases and macros for curist class
#nop =====================================================

#nop ------------------ SPELL / SKILL UTILITIES ------------------

#nop AFX - Check buffs and recast missing ones
#VARIABLE {has_armor} {0}

#alias {heal %1} {sli 'heal' %1}
#alias {healme} {sli 'heal' $me}

#ACTION {$leader telepaths to you, 'heal'} {sli 'heal' $leader}

#ACTION {^SPL: %* armor} {#variable {has_armor} {1}}
#ACTION {TIMER: %*} {
	#delay {2} {
		#if {$has_armor == 0 && $lvl > 8}{sli 'aura of prot'};
	}
}

#nop Aura falls off messages
#ACTION {You feel less protected.} {
	#variable {has_armor} {0};
	#if {$lvl > 8}{sli 'aura of prot'}
}
#ACTION {%1 looks less protected.} {
	#if {$lvl > 8 && ("%1" == "${leader}" || %1 in {${followers}[]})}{sli 'aura of prot'};
	#if {"%1" == "${me}"}{#variable {has_armor} {0}}
}


#nop ------------------ LEVEL-DRIVEN ACTIONS ------------------
#ACTION {[Regen]} {#if {$lvl > 8}{afx}}


#nop Auto-heal group members below 75% HP from group status output
#class autoheal open
	#var {autoheal_on} {1}
	 #TICKER {curist_group_check} {gr} {3}
	 #action {[%1 %2] %3 : [%4/%5]H %*} {
		 #nop #showme {DEBUG: lvl=%1 class=%2 name=%3 hp=%4 maxhp=%5};
		 #math {target_hp_pct} {100 * %4 / %5};
		 #nop #showme {DEBUG: pct=$target_hp_pct};
		 #if {$target_hp_pct < 75 && $lvl > 13} {sli 'heal' %3}
	 }
#class autoheal close

#nop ------------------ AUTOHEAL CONTROL ------------------
#alias {autoheal_on} {
	#read {nukefire/curist.tin};
	#class {autoheal} {open};
	#var {autoheal_on} {1};
	#showme {Autoheal ON};
	#send {}
}
#alias {autoheal_off} {
	#class {autoheal} {clear};
	#var {autoheal_on} {0};
	#showme {Autoheal OFF};
	#send {}
}
#alias {autoheal} {
	#if {$autoheal_on} {autoheal_off} {autoheal_on}
}