#nop =====================================================
#nop CURIST COMBAT
#nop Combat aliases and macros for curist class
#nop =====================================================

#nop ------------------ SPELL / SKILL UTILITIES ------------------

#nop AFX - Check buffs and recast missing ones
#VARIABLE {has_armor} {0}

#alias {rec} {sli 'word of recall'}

#alias {heal %1} {#if {$lvl > 24} {sli 'rejuvinate' %1} {#if {$lvl > 13} {sli 'heal' %1} {#if {$lvl > 8} {sli 'cure critic' %1}}}}
#alias {healme} {#if {$lvl > 24} {sli 'rejuvinate' $me} {#if {$lvl > 13} {sli 'heal' $me} {#if {$lvl > 8} {sli 'cure critic' $me}}}}

#alias {invig %1} {#if {$lvl > 17} {sli 'invigorate' %1}}
#alias {invigme} {#if {$lvl > 17} {sli 'invigorate' $me}}

#ACTION {$leader telepaths to you, 'heal'} {#if {$lvl > 24} {sli 'rejuvinate' $leader} {#if {$lvl > 13} {sli 'heal' $leader} {#if {$lvl > 8} {sli 'cure critic' $leader}}}}
#ACTION {$leader telepaths to you, 'invig'} {#if {$lvl > 17} {sli 'invigorate' $leader}}

#ACTION {^SPL: %* armor} {#variable {has_armor} {1}}
#ACTION {TIMER: %*} {
	#delay {2} {
		#if {$has_armor == 0 && $lvl > 8}{sli 'aura of prot'};
	}
}

#nop Aura falls off messages
#ACTION {You feel less protected.} {
	#variable {has_armor} {0};
	#if {$lvl > 8}{sli 'aura of prot'}
}
#ACTION {%1 looks less protected.} {
	#if {$lvl > 8 && ("%1" == "${leader}" || %1 in {${followers}[]})}{sli 'aura of prot'};
	#if {"%1" == "${me}"}{#variable {has_armor} {0}}
}


#nop ------------------ LEVEL-DRIVEN ACTIONS ------------------
#ACTION {[Regen]} {#if {$lvl > 8}{afx}}


#nop Group status ticker for autoheal and autoinvig
#class groupcheck open
	#var {groupcheck_on} {1}
	#TICKER {curist_group_check} {gr} {3}
#class groupcheck close

#nop Auto-heal group members below 75% HP from group status output
#class autoheal open
	#action {[%1 %2] %3 %*: [%4/%5]H %* [%6/%7]V} {
		#nop #showme {DEBUG: lvl=%1 class=%2 name=%3 hp=%4 maxhp=%5 mv=%6 maxmv=%7};
		#math {target_hp_pct} {100 * %4 / %5};
		#math {target_v_pct} {100 * %6 / %7};
		#nop #showme {DEBUG: pct=$target_hp_pct};
		#nop #showme {DEBUG: pct=$target_v_pct};
		#if {$target_hp_pct < 75} {#if {$lvl > 24} {sli 'rejuvinate' %3} {#if {$lvl > 13} {sli 'heal' %3} {#if {$lvl > 8} {sli 'cure critic' %3}}}};
		#if {$target_v_pct < 50 && $lvl > 17} {sli 'invigorate' %3}
	}
#class autoheal close

#nop ------------------ AUTOHEAL CONTROL ------------------
#alias {autoheal_on} {
	#read {nukefire/curist.tin};
	#class {autoheal} {open};
	#var {autoheal_on} {1};
	#showme {Autoheal ON};
	#send {}
}
#alias {autoheal_off} {
	#class {autoheal} {clear};
	#var {autoheal_on} {0};
	#showme {Autoheal OFF};
	#send {}
}
#alias {autoheal} {
	#if {$autoheal_on} {autoheal_off} {autoheal_on}
}

#nop ------------------ GROUPCHECK CONTROL ------------------
#alias {groupcheck_on} {
	#read {nukefire/curist.tin};
	#class {groupcheck} {open};
	#var {groupcheck_on} {1};
	#showme {Groupcheck ON};
	#send {}
}
#alias {groupcheck_off} {
	#class {groupcheck} {clear};
	#var {groupcheck_on} {0};
	#showme {Groupcheck OFF};
	#send {}
}
#alias {groupcheck} {
	#if {$groupcheck_on} {groupcheck_off} {groupcheck_on}
}

#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		combo bash bash bash;
	}
}