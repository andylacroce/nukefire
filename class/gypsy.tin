#nop =====================================================
#nop GYPSY COMBAT
#nop Combat aliases and macros for gypsy class
#nop =====================================================

#nop ------------------ COMBAT ALIASES ------------------
#ALIAS {xx} {shoot mob burst}
#ALIAS {aaa} {#if {$lvl > 49}{sli 'rot'};shred}
#ALIAS {rr} {hyp mob;backstab mob;#if {$lvl > 14}{mysticveil};#if {$lvl > 44}{vtwist};#if {$lvl > 39}{bgrow};#if {$lvl > 34}{spiritr};#if {$lvl > 34}{sucker}}
#ALIAS {grows} {grow scar}

#nop ------------------ MACROS ------------------
#MACRO {-} {aaa}
#MACRO {=} {rr}

#nop ------------------ SPELL / SKILL UTILITIES ------------------
#ALIAS {cb %1} {sli 'cure blind' %1}
#ALIAS {rc %1} {sli 'remove curse' %1}
#ALIAS {tarot_group} {group_targeted tarot}
#ALIAS {fa} {first %1}
#ALIAS {fam} {first $me}

#nop ------------------ AFX - BUFF MANAGEMENT ------------------
#nop Check buffs and recast missing ones
#VARIABLE {has_voodoo} {0}
#VARIABLE {has_phantom} {0}
#VARIABLE {has_fortune} {0}
#VARIABLE {grows_max_hp} {0}
#VARIABLE {grows_set_on_next_prompt} {0}
#VARIABLE {grows_cooldown} {0}
#VARIABLE {autoheal_on} {1}
#VARIABLE {rom_cd} {0}
#VARIABLE {tarot_cd} {0}

#nop ------------------ EXPERIENCE TRIGGERS ------------------
#alias {_gypsy_on_xp} {
	#if {$lvl > 19 && $rom_cd == 0} {rom; #var rom_cd 1; #delay {20} {#var rom_cd 0};};
	#if {$lvl > 39 && $tarot_cd == 0} {tarot_group; #var tarot_cd 1; #delay {20} {#var tarot_cd 0};};
}

#action {You receive %1 experience points.} {_gypsy_on_xp}
#action {You can't gain anymore experience.} {_gypsy_on_xp}

#ACTION {^SPL: %* voodoo contract} {#variable {has_voodoo} {1}}
#ACTION {^SPL: %* phantom mirage} {#variable {has_phantom} {1}}
#ACTION {^SPL: %* fortune's blessing} {#variable {has_fortune} {1}}
#ACTION {TIMER: %*} {
	#delay {2} {
		#if {"%1" != "%*Gypsy_Dance%*" && $lvl > 19}{rom};
		#if {$has_voodoo == 0 && $lvl > 39}{sign};
		#if {$has_phantom == 0 && $lvl > 24}{mir};
		#if {$has_fortune == 0 && $lvl > 39}{tarot_group};
		#variable {has_voodoo} {0};
		#variable {has_phantom} {0};
		#variable {has_fortune} {0}
	}
}

#nop ------------------ FALL-OFF HANDLERS ------------------
#nop Fortune falls off messages
#ACTION {Fortune's blessing retreats from you.} {
	#variable {has_fortune} {0};
	#if {$lvl > 39}{tarot_group};
} 
#ACTION {The shimmer of Fortune's blessing fades from around %1.} {
	#var recaster %1;
	is_group_member %1;
	#if {$lvl > 39 && $igm_result == 1}{tarot_group};
} 

#nop ------------------ GROWS / HP MAX TRACKING ------------------
#ACTION {You're already as healthy as you can be.} {
    #var {grows_set_on_next_prompt} {1};
}

#action {< %1H %2M %3V%* [Lvl %4, %5]%*} {
	#variable {lvl} {%4};
    #variable {exp_to_level} {%5};
    #if {$grows_set_on_next_prompt == 1} {
        #var {grows_max_hp} {%1};
        #var {grows_set_on_next_prompt} {0};
    };
    #if {%1 > $grows_max_hp} {
        #var {grows_max_hp} {%1};
    };
    #if {$grows_max_hp > 0} {
        #math {grows_pct} {100 * %1 / $grows_max_hp};
        #if {$grows_pct < 50 && $grows_cooldown == 0 && $autoheal_on} {
            grows;
            #var {grows_cooldown} {1};
            #delay {5} {#var {grows_cooldown} {0};};
        };
    };
}

#alias {autoheal_on}  {#var {autoheal_on} {1};  #showme {Autoheal ON};  #send {}}
#alias {autoheal_off} {#var {autoheal_on} {0};  #showme {Autoheal OFF}; #send {}}
#alias {autoheal}     {#if {$autoheal_on} {autoheal_off} {autoheal_on}}

#nop ------------------ LEVEL-DRIVEN ACTIONS ------------------
#ACTION {[Regen]} {#if {$lvl > 24}{afx}}
#ACTION {The dance comes to a graceful end, as you posture and bow.} {rom}
#ACTION {The mirages fade away, leaving you exposed.} {mir}
#ACTION {Your Voodoo Contract has been broken, the hex dissipates.} {sign}
#ACTION {Your attempt to establish the Voodoo Contract fails.} {sign}

#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 35}     {set_combo disem disem disem};
		#elseif {$lvl < 45} {set_combo spiritr sucker sucker};
		#else               {set_combo impale spiritr sucker};
	}
}
