#nop =====================================================
#nop GYPSY COMBAT
#nop Combat aliases and macros for gypsy class
#nop =====================================================

#nop ------------------ COMBAT ALIASES ------------------
#ALIAS {xx} {shoot mob burst}
#ALIAS {aaa} {#if {$lvl > 49}{sli 'rot'};shred}
#ALIAS {rr} {
	hyp mob;
	tel rancor o stalk mob;
	#delay {.5} {
		resc rancor;
		#if {$lvl > 44}{impale mob};
		#else {shackle mob};
		otf assist mutiny;
		otf assist rancor;
		otf rr;
		#if {$lvl > 39}{bgrow};
		#if {$lvl > 14}{mysticveil};
		#if {$lvl > 44}{vtwist};
		shackle;
		omen;
		#if {$lvl > 44}{impale};
	}
}

#nop ------------------ MACROS ------------------
#MACRO {-} {aaa}

#nop ------------------ SPELL / SKILL UTILITIES ------------------
#ALIAS {cb %1} {sli 'cure blind' %1}
#ALIAS {rc %1} {sli 'remove curse' %1}
#ALIAS {tarot_group} {group_targeted tarot}
#ALIAS {fa} {first %1}
#ALIAS {fam} {first $me}

#nop ------------------ AFX - BUFF MANAGEMENT ------------------
#nop Check buffs and recast missing ones
#VARIABLE {has_voodoo} {0}
#VARIABLE {has_phantom} {0}
#VARIABLE {has_fortune} {0}
#VARIABLE {grows_cooldown} {0}
#VARIABLE {autoheal_on} {1}
#VARIABLE {rom_cd} {0}
#VARIABLE {tarot_cd} {0}

#nop ------------------ EXPERIENCE TRIGGERS ------------------
#alias {_gypsy_on_xp} {
	#if {$lvl > 19 && $rom_cd == 0} {rom; #var rom_cd 1; #delay {20} {#var rom_cd 0};};
	#if {$lvl > 39 && $tarot_cd == 0} {tarot_group; #var tarot_cd 1; #delay {180} {#var tarot_cd 0};};
}

#action {You receive %1 experience points.} {_gypsy_on_xp; _track_xp %1}
#action {You can't gain anymore experience.} {_gypsy_on_xp}

#ACTION {%*) voodoo contract%*} {#variable {has_voodoo} {1}} {2}
#ACTION {%*) phantom mirage%*} {#variable {has_phantom} {1}} {2}
#ACTION {%*) fortune's blessing%*} {#variable {has_fortune} {1}} {2}
#ACTION {Timer Flags: %*} {
	#delay {2} {
		#if {"%1" != "%*Gypsy_Dance%*" && $lvl > 19}{rom};
		#if {$has_voodoo == 0 && $lvl > 39}{sign};
		#if {$has_phantom == 0 && $lvl > 24}{mir};
		#if {$has_fortune == 0 && $lvl > 39}{tarot_group};
		#variable {has_voodoo} {0};
		#variable {has_phantom} {0};
		#nop has_fortune is NOT reset here -- fall-off handler and SPL trigger own its state
	}
}

#nop ------------------ FALL-OFF HANDLERS ------------------
#nop Fortune falls off messages
#ACTION {Fortune's blessing retreats from you.} {
	#variable {has_fortune} {0};
	#if {$lvl > 39}{tarot $me};
}
#ACTION {The shimmer of Fortune's blessing fades from around %1.} {
	#var recaster %1;
	is_group_member %1;
	#if {$lvl > 39 && $igm_result == 1}{tarot $recaster};
}

#nop ------------------ GROW SCAR: GMCP-BASED ------------------
#alias {_on_gmcp_vitals} {
    #local chp  {$gmcp[char][vitals][hp]};
    #local cmhp {$gmcp[char][maxstats][maxhp]};
    #if {$cmhp > 0} {
        #math hp_pct {100 * $chp / $cmhp};
        #if {$hp_pct < 50 && $grows_cooldown == 0 && $autoheal_on} {
            grows;
            #variable {grows_cooldown} {1};
            #delay {5} {#variable {grows_cooldown} {0};};
        };
    };
}

#nop ------------------ LEVEL-DRIVEN ACTIONS ------------------
#ACTION {The dance comes to a graceful end, as you posture and bow.} {rom}
#ACTION {The mirages fade away, leaving you exposed.} {mir}
#ACTION {Your Voodoo Contract has been broken, the hex dissipates.} {sign}
#ACTION {Your attempt to establish the Voodoo Contract fails.} {sign}

#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 35}     {set_combo shackle omen omen};
		#elseif {$lvl < 45} {set_combo shackle omen spiritr};
		#else               {set_combo shackle omen impale};
	}
}
