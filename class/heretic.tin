#nop =====================================================
#nop HERETIC - aliases, toggles, buffs, and autoheal
#nop =====================================================

#nop ------------------ ALIASES ------------------
#alias {fort} {sli 'aura of fort'; #variable {has_fort} {1};}
#alias {sum %1} {#if {$lvl > 9} {sli 'summon' %1}}
#alias {esc} {#if {$lvl > 16} {sli 'aura of escape'}}
#alias {wyrm} {#if {$lvl > 49} {sli 'wyrm'}}
#alias {sof} {#if {$lvl > 49} {sli 'shield of flames'}}
#alias {hellquake} {#if {$lvl > 44} {sli 'hellquake'}}

#nop ------------------ IMMOLATE TOGGLE ------------------
#var {immolate_on} {1};

#class immolate open
    #action {You receive %1 experience points.} {
        immo corpse;
    }
    #action {You can't gain anymore experience.} {
        immo corpse;
    }
#class immolate close
#if {!$immolate_on} {#class {immolate} {clear}}

#alias {immolate_on} {
    #var {immolate_on} {1};
    #read {nukefire/class/heretic.tin};
    #showme {Immolate ON};
    #send {}
}
#alias {immolate_off} {
    #var {immolate_on} {0};
    #class {immolate} {clear};
    #showme {Immolate OFF};
    #send {}
}
#alias {immolate} {
    #if {$immolate_on} {immolate_off} {immolate_on}
}
#nop ------------------ SHIELD OF FLAMES TOGGLE ------------------
#variable {flames_on} {1}
#alias {flames_on} {#var {flames_on} {1};#showme {Shield of Flames ON};#send {}}
#alias {flames_off} {#var {flames_on} {0};#showme {Shield of Flames OFF};#send {}}
#alias {flames} {#if {$flames_on} {flames_off} {flames_on}}

#nop ------------------ BUFF TRACKING ------------------
#variable {has_fort} {0}
#variable {has_unholy} {0}
#variable {has_dark} {0}
#variable {has_covenant} {0}
#variable {has_shield_of_flames} {0}
#ACTION {^SPL: %* fortify} {#variable {has_fort} {1}}
#ACTION {^SPL: %* unholyfist} {#variable {has_unholy} {1}}
#ACTION {^SPL: %* dark blessing} {#variable {has_dark} {1}}
#ACTION {^SPL: %* dark covenant} {#variable {has_covenant} {1}}
#ACTION {^SPL: %* shield of flames} {#variable {has_shield_of_flames} {1}}

#nop ------------------ AUTO-CAST / TIMER ------------------
#ACTION {TIMER: %*} {
    #delay {2} {
        #if {$has_fort == 0 && $lvl > 8} {sli 'aura of fort'; #variable {has_fort} {1};};
        #if {$has_unholy == 0 && $lvl > 10} {sli 'unholyfist'};
        #if {$has_dark == 0 && $lvl > 21} {sli 'aura of dark'; #variable {has_dark} {1};};
        #if {$has_covenant == 0 && $lvl > 24} {covenant};
        #if {$has_shield_of_flames == 0 && $flames_on} {sof};
        #variable {has_fort} {0};
        #variable {has_unholy} {0};
        #variable {has_dark} {0};
        #variable {has_covenant} {0};
        #variable {has_shield_of_flames} {0};
    }
}

#nop ------------------ FORTUNE FALL HANDLERS ------------------
#ACTION {Fortune's blessing retreats from you.} {
    #variable {has_fort} {0};
    #if {$lvl > 8} {sli 'aura of fort'; #variable {has_fort} {1};};
}
#ACTION {The shimmer of Fortune's blessing fades from around %1.} {
    #variable {has_fort} {0};
    is_group_member %1;
    #if {$lvl > 8 && $igm_result == 1} {sli 'aura of fort'; #variable {has_fort} {1};};
}
#ACTION {You feel less fortified.} {
    #variable {has_fort} {0};
    #if {$lvl > 8} {sli 'aura of fort'; #variable {has_fort} {1};};
}
#ACTION {%1 looks less fortified.} {
    #variable {has_fort} {0};
    is_group_member %1;
    #if {$lvl > 8 && $igm_result == 1} {sli 'aura of fort'; #variable {has_fort} {1};};
}

#nop ------------------ DARK BLESSING FALL HANDLERS ------------------
#ACTION {You feel your dark blessing retreat.} {
    #variable {has_dark} {0};
    #if {$lvl > 21} {sli 'aura of dark'; #variable {has_dark} {1};};
}
#ACTION {The dark aura around %1 thins and fades.} {
    #variable {has_dark} {0};
    is_group_member %1;
    #if {$lvl > 21 && $igm_result == 1} {sli 'aura of dark'; #variable {has_dark} {1};};
}

#nop ------------------ COVENANT FALL HANDLERS ------------------
#ACTION {Your Dark Covenant is broken. The heretical energy dissipates.} {
    #variable {has_covenant} {0};
    #if {$lvl > 24} {covenant};
}

#nop ------------------ SHIELD OF FLAMES FALL HANDLERS ------------------
#ACTION {Your Shield of Flames is ready to wield.} {
    #variable {has_shield_of_flames} {0};
    #if {$flames_on} {sof};
}

#nop ------------------ AUTOHEAL / GROUPCHECK ------------------
#class groupcheck open
    #var {groupcheck_on} {1}
    #TICKER {heretic_group_check} {gr} {3}
#class groupcheck close

#class autoheal open
    #action {[%1 %2] %3 %*: [%4/%5]H %* [%6/%7]V} {
        #math {target_hp_pct} {100 * %4 / %5};
        #math {target_v_pct} {100 * %6 / %7};
        #if {$target_v_pct < 85 && $lvl > 17} {sli 'sinful vigor' %3};
        #if {"%$target_hp_pct < 85} {
            #if {"%3" == "$me" && $lvl > 25} {sli 'augury' $me};
            #elseif {$lvl > 39} {sli 'demon' %3};
            #elseif {$lvl > 24} {sli 'rejuvinate' %3};
        };
    }
#class autoheal close

#alias {autoheal_on} {
    #read {nukefire/class/heretic.tin};
    #class {autoheal} {open};
    #var {autoheal_on} {1};
    #showme {Autoheal ON};
    #send {}
}
#alias {autoheal_off} {
    #class {autoheal} {clear};
    #var {autoheal_on} {0};
    #showme {Autoheal OFF};
    #send {}
}
#alias {autoheal} {
    #if {$autoheal_on} {autoheal_off} {autoheal_on}
}

#alias {groupcheck_on} {
    #read {nukefire/class/heretic.tin};
    #class {groupcheck} {open};
    #var {groupcheck_on} {1};
    #showme {Groupcheck ON};
    #send {}
}
#alias {groupcheck_off} {
    #class {groupcheck} {clear};
    #var {groupcheck_on} {0};
    #showme {Groupcheck OFF};
    #send {}
}
#alias {groupcheck} {
    #if {$groupcheck_on} {groupcheck_off} {groupcheck_on}
}


#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 24} {
			combo bash bash bash;
			#var {group_combo} {bash bash bash};
			groupassist_group;
		};
		#elseif {$lvl < 35} {
			combo here here here;
			#var {group_combo} {here here here};
			groupassist_group;
		};
        #elseif {$lvl < 45} {
			combo torment torment torment;
			#var {group_combo} {torment torment torment};
			groupassist_group;
		};
        #else {
			combo hellquake hellquake hellquake;
			#var {group_combo} {hellquake hellquake hellquake};
			groupassist_group;
		};
	}
}

