#nop =====================================================
#nop HERETIC - aliases, toggles, buffs, and autoheal
#nop =====================================================

#nop ------------------ ALIASES ------------------
#variable {heretic_combat_cd} {0}
#alias {rr} {#if {$heretic_combat_cd == 0} {#if {$lvl < 35} {brand} {torment}; #variable heretic_combat_cd 1; #delay {10} {#variable heretic_combat_cd 0}}}

#alias {fort} {sli 'aura of fort'; #variable {has_fort} {1};}
#alias {sum %1} {#if {$lvl > 9} {tel $leader @-@B<< SUMMONING %1 >>@n;sli 'summon' %1}}
#alias {esc} {#if {$lvl > 16} {sli 'aura of escape'}}
#alias {wyrm} {#if {$lvl > 49} {sli 'wyrm'}}
#alias {sof} {#if {$lvl > 49} {sli 'shield of flames'}}
#alias {hellquake} {#if {$lvl > 44 && $heretic_combat_cd == 0} {sli 'hellquake'; #variable heretic_combat_cd 1; #delay {10} {#variable heretic_combat_cd 0}}}
#alias {heal %1} {sli 'soul swell' %1}

#nop ------------------ IMMOLATE TOGGLE ------------------
#variable {immolate_on} {1};

#class immolate open
    #action {You receive %1 experience points.} {
        immo corpse;
        _track_xp %1;
    }
    #action {You can't gain anymore experience.} {
        immo corpse;
    }
#class immolate close
#if {!$immolate_on} {#class {immolate} {clear}}

#alias {immolate_on} {
    #class {immolate} {open};
    #action {You receive %%1 experience points.} {immo corpse; _track_xp %%1;};
    #action {You can't gain anymore experience.} {immo corpse;};
    #class {immolate} {close};
    #variable {immolate_on} {1};
    #showme {Immolate ON};
    #send {}
}
#alias {immolate_off} {
    #variable {immolate_on} {0};
    #class {immolate} {clear};
    #showme {Immolate OFF};
    #send {}
}
#alias {immolate} {
    #if {$immolate_on} {immolate_off} {immolate_on}
}
#nop ------------------ SHIELD OF FLAMES TOGGLE ------------------
#variable {flames_on} {1}
#alias {flames_on} {#variable {flames_on} {1};#showme {Shield of Flames ON};#send {}}
#alias {flames_off} {#variable {flames_on} {0};#showme {Shield of Flames OFF};#send {}}
#alias {flames} {#if {$flames_on} {flames_off} {flames_on}}

#nop ------------------ BUFF TRACKING ------------------
#variable {has_fort} {0}
#variable {has_unholy} {0}
#variable {has_dark} {0}
#variable {has_covenant} {0}
#variable {has_shield_of_flames} {0}
#variable {fort_cd} {0}
#variable {dark_cd} {0}
#ACTION {%*) fortify%*} {#variable {has_fort} {1}} {2}
#ACTION {%*) unholyfist%*} {#variable {has_unholy} {1}} {2}
#ACTION {%*) dark blessing%*} {#variable {has_dark} {1}} {2}
#ACTION {%*) dark covenant%*} {#variable {has_covenant} {1}} {2}
#ACTION {%*) shield of flames%*} {#variable {has_shield_of_flames} {1}} {2}

#nop ------------------ AUTO-CAST / TIMER ------------------
#ACTION {Timer Flags: %*} {
    #delay {2} {
        #if {$has_fort == 0 && $lvl > 8} {sli 'aura of fort'; #variable {has_fort} {1};};
        #if {$has_unholy == 0 && $lvl > 10} {sli 'unholyfist'};
        #if {$has_dark == 0 && $lvl > 21} {sli 'aura of dark'; #variable {has_dark} {1};};
        #if {$has_covenant == 0 && $lvl > 24} {covenant};
        #if {$has_shield_of_flames == 0 && $flames_on} {sof};
        #variable {has_fort} {0};
        #variable {has_unholy} {0};
        #variable {has_dark} {0};
        #variable {has_covenant} {0};
        #variable {has_shield_of_flames} {0};
    }
}

#nop ------------------ FORTIFICATION FALL HANDLERS ------------------
#ACTION {You feel less fortified.} {
    #variable {has_fort} {0};
    #if {$lvl > 8} {sli 'aura of fort'; #variable {has_fort} {1};};
}
#ACTION {%1 looks less fortified.} {
    #variable {has_fort} {0};
    is_group_member %1;
    #if {$lvl > 8 && $igm_result == 1 && $fort_cd == 0} {sli 'aura of fort'; #variable {has_fort} {1}; #variable fort_cd 1; #delay {3} {#variable fort_cd 0};};
}

#nop ------------------ DARK BLESSING FALL HANDLERS ------------------
#ACTION {You feel your dark blessing retreat.} {
    #variable {has_dark} {0};
    #if {$lvl > 21} {sli 'aura of dark'; #variable {has_dark} {1};};
}
#ACTION {The dark aura around %1 thins and fades.} {
    #variable {has_dark} {0};
    is_group_member %1;
    #if {$lvl > 21 && $igm_result == 1 && $dark_cd == 0} {sli 'aura of dark'; #variable {has_dark} {1}; #variable dark_cd 1; #delay {3} {#variable dark_cd 0};};
}

#nop ------------------ COVENANT FALL HANDLERS ------------------
#ACTION {Your Dark Covenant is broken. The heretical energy dissipates.} {
    #variable {has_covenant} {0};
    #if {$lvl > 24} {covenant};
}

#nop ------------------ SHIELD OF FLAMES FALL HANDLERS ------------------
#ACTION {Your Shield of Flames is ready to wield.} {
    #variable {has_shield_of_flames} {0};
    #if {$flames_on} {sof};
}

#nop ------------------ AUGURY: GMCP-BASED SELF-HEAL (100% restore) ------------------
#variable {augury_cooldown} {0}

#alias {_on_gmcp_vitals} {
    #local chp  {$gmcp[char][vitals][hp]};
    #local cmhp {$gmcp[char][maxstats][maxhp]};
    #if {$cmhp > 0} {
        #math hp_pct {100 * $chp / $cmhp};
        #if {$hp_pct < 80 && $autoheal_on && $augury_cooldown == 0} {
            tel $leader @-@Y<< HEALING $me >> @n@y($chp/$cmhp HP, @+@Y$hp_pct%@n@y);
            #if {$lvl >= 26} {sli 'augury' $me} {sli 'soul swell' $me};
            #variable augury_cooldown 1; #delay {3} {#variable augury_cooldown 0};
        };
    };
}

#nop ------------------ AUTOHEAL / GROUPCHECK ------------------
#nop GMCP-driven hook: fires automatically on every group update from server
#variable {autoheal_on} {1}
#variable {sinvig_cooldown} {0}
#variable {heal_cooldown} {0}
#variable {emergency_cooldown} {0}
#variable {heal_focus} {}
#variable {heal_focus_pct_at_cast} {0}
#variable {heal_focus_retries} {0}

#nop Follow-up healer: re-checks heal_focus target after cooldown -- chains until target >= 75%
#alias {_maybe_followup_heal} {
    #if {"$heal_focus" == "" || !$autoheal_on} {#return};
    #if {$heal_cooldown} {#return};
    #nop bail after 10 attempts with no meaningful progress (target may be out of range or in combat elsewhere) --;
    #if {$heal_focus_retries >= 10} {
        #variable heal_focus {};
        #variable heal_focus_retries {0};
        #return;
    };
    #local focus_pct {101};
    #local focus_hp  {0};
    #local focus_mhp {0};
    #local gi {1};
    #while {$gi <= $gmcp[group][count]} {
        #local mname {$gmcp[group][members][$gi][name]};
        #if {"$mname" == "$heal_focus"} {
            #local focus_hp  {$gmcp[group][members][$gi][info][hp]};
            #local focus_mhp {$gmcp[group][members][$gi][info][mhp]};
            #if {$focus_mhp > 0} {#math focus_pct {100 * $focus_hp / $focus_mhp}};
        };
        #math gi {$gi + 1};
    };
    #if {$focus_pct < 80} {
        #nop bail if target improved above 70% -- upward movement means the heal landed, close enough --;
        #if {$focus_pct > 70 && $focus_pct > $heal_focus_pct_at_cast} {
            #variable heal_focus {};
            #variable heal_focus_retries {0};
            #return;
        };
        #math heal_focus_retries {$heal_focus_retries + 1};
        #variable heal_focus_pct_at_cast {$focus_pct};
        tel $leader @-@R<< FOCUS HEAL $heal_focus >> @n@r($focus_hp/$focus_mhp HP, @+@R$focus_pct%@n@r);
        heal $heal_focus;
        #variable heal_cooldown 1; #delay {3} {#variable heal_cooldown 0; _maybe_followup_heal};
    } {
        #variable heal_focus {};
        #variable heal_focus_retries {0};
    };
}

#alias {_on_gmcp_group} {
    #nop -- EMERGENCY: bypass heal_cooldown for any member below 30% --;
    #if {$autoheal_on} {
        #local gi {1};
        #while {$gi <= $gmcp[group][count]} {
            #local mname {$gmcp[group][members][$gi][name]};
            #local mhp   {$gmcp[group][members][$gi][info][hp]};
            #local mmhp  {$gmcp[group][members][$gi][info][mhp]};
            #if {$mmhp > 0} {#math hp_pct {100 * $mhp / $mmhp}} {#local hp_pct {101}};
            #if {"$mname" != "$me" && $mhp > 0 && $hp_pct < 40 && !$emergency_cooldown} {
                #if {"$heal_focus" != "$mname"} {#variable heal_focus_retries {0}};
                #variable heal_focus {$mname};
                #variable emergency_cooldown {1};
                tel $leader @-@R<< EMERGENCY $mname >> @n@r($mhp/$mmhp HP, @+@R$hp_pct%@n@r);
                heal $mname;
                #variable heal_cooldown 1; #delay {5} {#variable heal_cooldown 0; #variable emergency_cooldown 0; _maybe_followup_heal};
                #return;
            };
            #math gi {$gi + 1};
        };
    };
    #nop -- bail if followup chain is active, unless a new critical target has appeared --;
    #if {"$heal_focus" != ""} {
        #local gi {1};
        #local found_critical {0};
        #while {$gi <= $gmcp[group][count]} {
            #local mname {$gmcp[group][members][$gi][name]};
            #local mhp   {$gmcp[group][members][$gi][info][hp]};
            #local mmhp  {$gmcp[group][members][$gi][info][mhp]};
            #if {$mmhp > 0} {#math hp_pct {100 * $mhp / $mmhp}} {#local hp_pct {101}};
            #if {"$mname" != "$me" && "$mname" != "$heal_focus" && $hp_pct < 50} {
                #local found_critical {1};
            };
            #math gi {$gi + 1};
        };
        #if {!$found_critical} {#return};
        #variable heal_focus {};
    };
    #nop -- PASS 1: scan members, decide AoE top-off vs single focused heal --;
    #if {$autoheal_on && $heal_cooldown == 0} {
        #local below_count {0};
        #local lowest_pct  {101};
        #local lowest_name {};
        #local lowest_hp   {0};
        #local lowest_mhp  {0};
        #local gi {1};
        #while {$gi <= $gmcp[group][count]} {
            #local mname {$gmcp[group][members][$gi][name]};
            #local mhp   {$gmcp[group][members][$gi][info][hp]};
            #local mmhp  {$gmcp[group][members][$gi][info][mhp]};
            #if {$mmhp > 0} {#math hp_pct {100 * $mhp / $mmhp}} {#local hp_pct {101}};
            #if {$mhp > 0 && $hp_pct < 80} {#math below_count {$below_count + 1}};
            #if {"$mname" != "$me" && $mhp > 0 && $hp_pct < $lowest_pct} {
                #local lowest_pct  {$hp_pct};
                #local lowest_name {$mname};
                #local lowest_hp   {$mhp};
                #local lowest_mhp  {$mmhp};
            };
            #math gi {$gi + 1};
        };
        #nop AoE only when 2+ need topping off and nobody is critically low (>=55%) -- below 55% gets individual attention --;
        #if {$below_count > 1 && $lvl > 34 && $lowest_pct >= 60} {
            #variable heal_focus {};
            tel $leader @-@G<< AURA OF REJUV ($below_count low) >> @n@g;
            sli 'aura of rejuv';
            #variable heal_cooldown 1; #delay {3} {#variable heal_cooldown 0};
        };
        #elseif {$lowest_pct < 80 && "$lowest_name" != ""} {
            #variable heal_focus {$lowest_name};
            #variable heal_focus_retries {0};
            #variable heal_focus_pct_at_cast {$lowest_pct};
            tel $leader @-@Y<< HEALING $lowest_name >> @n@y($lowest_hp/$lowest_mhp HP, @+@Y$lowest_pct%@n@y);
            heal $lowest_name;
            #variable heal_cooldown 1; #delay {4} {#variable heal_cooldown 0; _maybe_followup_heal};
        };
    };
    #nop -- PASS 2: MV restore for lowest MV% member (lowest priority) --;
    #if {$autoheal_on && $lvl > 17 && $sinvig_cooldown == 0 && $heal_cooldown == 0} {
        #local lowest_mv_pct  {101};
        #local lowest_mv_name {};
        #local lowest_mv      {0};
        #local lowest_mmv     {0};
        #local gi {1};
        #while {$gi <= $gmcp[group][count]} {
            #local mname {$gmcp[group][members][$gi][name]};
            #local mmv   {$gmcp[group][members][$gi][info][mv]};
            #local mmmv  {$gmcp[group][members][$gi][info][mmv]};
            #if {$mmmv > 0} {#math mv_pct {100 * $mmv / $mmmv}} {#local mv_pct {101}};
            #if {$mv_pct < $lowest_mv_pct} {
                #local lowest_mv_pct  {$mv_pct};
                #local lowest_mv_name {$mname};
                #local lowest_mv      {$mmv};
                #local lowest_mmv     {$mmmv};
            };
            #math gi {$gi + 1};
        };
        #if {$lowest_mv_pct < 90 && "$lowest_mv_name" != ""} {
            tel $leader @-@C<< INVIGORATING $lowest_mv_name >> @n@c($lowest_mv/$lowest_mmv MV, @+@C$lowest_mv_pct%@n@c);
            sli 'sinful vigor' $lowest_mv_name;
            #variable sinvig_cooldown 1; #delay {3} {#variable sinvig_cooldown 0};
        };
    };
}

#variable {_sum_cd} {0}

#ACTION {%1 telepaths to you, 'sum'} {
    #if {"%1" == "${leader}"} {
        sum %1;
    };
    #elseif {!$_sum_cd} {
        sum %1;
        #variable {_sum_cd} {1};
        #delay {20} {#variable {_sum_cd} {0}};
    };
} {1}

#ACTION {You rise a level!} {
    sc;
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if     {$lvl < 35} {set_combo brand goring goring};
		#else   {set_combo torment brand goring};
	}
}

