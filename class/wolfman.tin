#nop =====================================================
#nop WOLFMAN - aliases, toggles, buffs, and helpers
#nop =====================================================

#alias {rr} {
	#if {$lvl < 20} {bash;bash;bash};
	#if {$lvl >= 20} {gnaw};
	#if {$lvl >= 20} {chilling};
	#if {$lvl >= 35} {srend};
	#if {$lvl >= 20} {pounce};
	#if {$lvl >= 20} {gutting};
}

#nop ------------------ CORE: STATE & HELPERS ------------------
#variable {wolfout_on} {1}
#variable {has_wolfout} {0}
#variable {frenzy_on} {1}
#variable {has_frenzy} {0}

#nop ------------------ BASIC ALIASES / TOGGLES ------------------
#alias {wolfout_on}  {#var {wolfout_on} {1};  #showme {Wolfout ON};  #send {}}
#alias {wolfout_off} {#var {wolfout_on} {0};  #showme {Wolfout OFF}; #send {}}
#alias {wolfout}     {#if {$wolfout_on} {wolfout_off} {wolfout_on}}
#nop legacy name, kept for scripts
#alias {wolfout_auto} {wolfout}

#alias {frenzy_on}  {#var {frenzy_on} {1};  #showme {Frenzy ON};  #send {}}
#alias {frenzy_off} {#var {frenzy_on} {0};  #showme {Frenzy OFF}; #send {}}
#alias {frenz}      {#if {$frenzy_on} {frenzy_off} {frenzy_on}}

#nop ------------------ AFX: SPELL LISTENERS & TIMER ------------------
#ACTION {^SPL: %* wolfout} {#variable {has_wolfout} {1}}
#ACTION {^SPL: %* contagious frenticism} {#variable {has_frenzy} {1}}

#ACTION {TIMER: %*} {
	#delay {2} {
		#if {$has_wolfout == 0 && $wolfout_on} {wolf};
		#variable {has_wolfout} {0};
		#if {$has_frenzy == 0 && $frenzy_on && $lvl > 39} {frenzy};
		#variable {has_frenzy} {0};
	}
}

#nop ------------------ FALL-OFF / AUTO-REAPPLY ------------------
#ACTION {The frenzy ebbs, leaving you with ragged breath and a fading taste of blood.} {
	#variable {has_frenzy} {0};
	#if {$lvl > 39 && $frenzy_on} {frenzy};
}

#nop ------------------ LEVEL-DRIVEN ACTIONS ------------------
#ACTION {[Regen]} {#if {$lvl > 14}{afx}}

#ACTION {You rise a level!} {
	sc;
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 20}     {set_combo bash bash bash};
		#elseif {$lvl < 35} {set_combo pounce pounce pounce};
		#else               {set_combo srend pounce srend};
	}
}

#nop ------------------ EXPERIENCE TRIGGERS ------------------
#alias {_wolfman_on_xp} {#if {$lvl > 39} {frenzy}}

#action {You receive %1 experience points.} {_wolfman_on_xp}
#action {You can't gain anymore experience.} {_wolfman_on_xp}

#nop ------------------ GROWS / HP MAX TRACKING ------------------
#variable {grows_max_hp} {0}
#variable {grows_cooldown} {0}
#variable {grows_set_on_next_prompt} {0}
#variable {autoheal_on} {1}

#ACTION {You're already as healthy as you can be.} {
	#var {grows_set_on_next_prompt} {1};
}

#action {< %1H %2M %3V%* [Lvl %4, %5]%*} {
	#variable {lvl} {%4};
	#variable {exp_to_level} {%5};
	#if {$grows_set_on_next_prompt == 1} {
		#var {grows_max_hp} {%1};
		#var {grows_set_on_next_prompt} {0};
	};
	#if {%1 > $grows_max_hp} {
		#var {grows_max_hp} {%1};
	};
	#if {$grows_max_hp > 0} {
		#math {grows_pct} {100 * %1 / $grows_max_hp};
		#if {$grows_pct < 50 && $grows_cooldown == 0 && $autoheal_on} {
			whisper $leader @-@C<< GROW SCAR $me >> @n@c(%1/$grows_max_hp HP, @+@C$grows_pct%@n@c);
			grows;
			#var {grows_cooldown} {1};
			#delay {5} {#var {grows_cooldown} {0};};
		};
	};
}

#nop ------------------ SKILL NOTES ------------------
#nop - REGENERATION - Level 1
#nop  While traditional healing doesn't help the Wolfman much, they have a much faster than normal
#nop  regeneration rate.
#nop - TRAIL - Level 1
#nop  The Wolfman examines the terrain to track their prey.
#nop - DUAL WIELD - Level 9
#nop - FERAL AGILITY - Level 15
#nop - PREDATORY INSTINCTS - Level 15
#nop - RENDING CLAWS - Level 15
#nop - BESTIAL FORTITUDE - Level 15
#nop - SAVAGE FORM - Level 15
#nop  These skills encompass the Wolfman's natural abilities, no need to type anything for
#nop  these.
#nop - WOLFOUT - Level 15
#nop  The primary ability of the Wolfman is to transform into a savage creature of fang and
#nop  claw, granting them many inherent benefits. While extremely potent, it does come with
#nop  some... side effects. This will turn all of your innate Wolfman abilities on.
#nop - GRUESOME GNAW - Level 20
#nop  The Wolfman targets his opponent's face with a bite attack, blinding them and rendering
#nop  them defenseless for a short while.
#nop - GUTTING STRIKE - Level 20
#nop  The Wolfman targets his opponent's vitals with a powerful clawed attack, eviscerating them.
#nop - CHILLING HOWL - Level 20
#nop - POUNCE - Level 20
#nop  The Wolfman pounces on his prey, knocking them down and stunning them.
#nop - STALK - Level 20
#nop  The Wolfman carefully stalks their prey and catches them off guard.
#nop - FEAST - Level 20
#nop  The Wolfman has a hunger for freshly-killed flesh.
#nop - CLAWED MASTER - Level 20
#nop  The Wolfman is a natural killer with those claws.
#nop - SUPREME REND - Level 35
#nop  The Wolfman's thick talons and powerful jaws rip into the enemy, causing huge
#nop  damage and a bleed.
#nop - RAGE - Level 35
#nop  A complete rage of attacks on all valid targets in a room. Gruesome.
#nop - CONTAGIOUS FRENETICISM - Level 40
#nop  The Wolfman's blood-hungry howl drives the pack into contagious
#nop  frenzy, sharpening their strikes and flooding them with wild vigor.