#nop =====================================================
#nop RANGER COMBAT
#nop Combat aliases and macros for gypsy class
#nop =====================================================

#nop ------------------ DEFAULT TOGGLES ------------------
#VARIABLE {autoheal_on} {1}
#VARIABLE {groupcheck_on} {1}

#ACTION {[Regen]} {#if {$lvl > 14}{afx}}

#nop ------------------ BARK SKIN REAPPLY ------------------
#nop Bark requires level > 14 to use/auto-cast
#variable {has_bark} {0}
#variable {has_totem} {0}

#action {SPL: %* bark skin} {#variable {has_bark} {1}}
#action {You invoke your bark skin, taking on a rough, tree-like appearance.} {#variable {has_bark} {1}}
#action {The bark-like texture surrounding you fades away as you cease concentration.} {#variable {has_bark} {0};#if {$lvl > 14} {bark;#variable {has_bark} {1}}} 

#action {^SPL: (perm) invisibility} {#variable {has_totem} {1}}
#action {Your an Animal Spirit Totem crumbles back into the earth.} {#variable {has_totem} {0};#if {$lvl > 11}{sli 'animal';hold totem;#variable {has_totem} {1}};} 

#action {TIMER: %*} {
	#variable {has_bark} {0};
	#variable {has_totem} {0};
	#delay {2} {
		#if {$lvl > 14} {
			#if {!$has_bark} {bark;#variable {has_bark} {1}}
		};
		#if {$lvl > 11} {
			#if {!$has_totem} {sli 'animal';hold totem;;#variable {has_totem} {1}}
		}
	}
} 

#nop Group status ticker for autoheal
#class groupcheck open
	#var {groupcheck_on} {1}
	#TICKER {ranger_group_check} {gr} {3}
#class groupcheck close

#nop Auto-heal group members below 75% HP from group status output
#class autoheal open
	#action {[%1 %2] %3 %*: [%4/%5]H %* [%6/%7]V} {
		#nop #showme {DEBUG: lvl=%1 class=%2 name=%3 hp=%4 maxhp=%5 mv=%6 maxmv=%7};
		#math {target_hp_pct} {100 * %4 / %5};
		#math {target_v_pct} {100 * %6 / %7};
		#nop #showme {DEBUG: pct=$target_hp_pct};
		#nop #showme {DEBUG: pct=$target_v_pct};
		#if {$target_hp_pct < 85} {sli 'rejuv' %3};
		#if {$target_v_pct < 50 && $lvl > 14} {sli 'invigorate' %3};
	}
#class autoheal close

#alias {heal %1} {sli 'rejuv' %1}
#alias {healme} {sli 'rejuv'}

#alias {invig %1} {#if {$lvl > 14} {sli 'invigorate' %1}}
#alias {invigme} {#if {$lvl > 14} {sli 'invigorate' $me}}
#ACTION {$leader telepaths to you, 'invig'} {#if {$lvl > 14} {sli 'invigorate' $leader}}

#nop ------------------ AUTOHEAL CONTROL ------------------
#alias {autoheal_on} {
	#read {nukefire/class/ranger.tin};
	#class {autoheal} {open};
	#var {autoheal_on} {1};
	#showme {Autoheal ON};
	#send {}
}
#alias {autoheal_off} {
	#class {autoheal} {clear};
	#var {autoheal_on} {0};
	#showme {Autoheal OFF};
	#send {}
}
#alias {autoheal} {
	#if {$autoheal_on} {autoheal_off} {autoheal_on}
}

#nop ------------------ GROUPCHECK CONTROL ------------------
#alias {groupcheck_on} {
	#read {nukefire/class/ranger.tin};
	#class {groupcheck} {open};
	#var {groupcheck_on} {1};
	#showme {Groupcheck ON};
	#send {}
}
#alias {groupcheck_off} {
	#class {groupcheck} {clear};
	#var {groupcheck_on} {0};
	#showme {Groupcheck OFF};
	#send {}
}
#alias {groupcheck} {
	#if {$groupcheck_on} {groupcheck_off} {groupcheck_on}
}

#ACTION {You rise a level!} {
	emote gained a level and dances a celebratory jig.;
	#delay {3} {
		#if {$lvl < 9} {
			combo kick kick kick;
			#var {group_combo} {kick kick kick};
			groupassist_group;
		};
		#elseif {$lvl < 15} {
			combo bash bash bash;
			#var {group_combo} {bash bash bash};
			groupassist_group;
		};
        #elseif {$lvl < 20} {
			combo bush bush bush;
			#var {group_combo} {bush bush bush};
			groupassist_group;
		};
		#else {
			combo grapple grapple grapple;
			#var {group_combo} {grapple grapple grapple};
			groupassist_group;
		}
	}
}