#nop =====================================================
#nop SLEEP & REST
#nop Sleep and posture management
#nop =====================================================

#ALIAS {sl} {
	#if {!$is_follower} {
		#var i 1;
		#while {$i <= &followers[]} {
			#list followers get $i follower;
			#if {"$follower" != "$me"} { tel $follower o sl; };
			#math i $i + 1;
		};
	};
	sleep;
}

#ALIAS {slw} {
	#if {!$is_follower} {
		#var i 1;
		#while {$i <= &followers[]} {
			#list followers get $i follower;
			#if {"$follower" != "$me"} { tel $follower o slw; };
			#math i $i + 1;
		};
	};
	sleep;wake;stand;
}

#ALIAS {wa} {
	#if {!$is_follower} {
		#var i 1;
		#while {$i <= &followers[]} {
			#list followers get $i follower;
			#if {"$follower" != "$me"} { tel $follower o wa; };
			#math i $i + 1;
		};
	};
	wake;stand;
}
