#nop =====================================================
#nop SLEEP & REST
#nop Sleep and posture management
#nop =====================================================

#ALIAS {sl} {
	#if {!$is_follower} {
		#foreach {$followers[%*]} {follower} {
			#if {"$follower" != "$me"} {tel $follower o sl};
		};
	};
	sleep;
}

#ALIAS {slw} {
	#if {!$is_follower} {
		#foreach {$followers[%*]} {follower} {
			#if {"$follower" != "$me"} {tel $follower o slw};
		};
	};
	sleep;wake;stand;
}

#ALIAS {wa} {
	#if {!$is_follower} {
		#foreach {$followers[%*]} {follower} {
			#if {"$follower" != "$me"} {tel $follower o wa};
		};
	};
	wake;stand;
}
