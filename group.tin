#nop =====================================================
#nop GROUP UTILITIES
#nop Group commands and coordination
#nop =====================================================

#nop ------------------ REPORT COMMAND ------------------
#ALIAS {rep} {report}

#ACTION {[Regen]} {afx}

#nop Helper: test if a name is the leader or a follower
#alias {is_group_member %1} {
	#var _igm_name %1;
	#var _igm_res 0;
	#if {"$_igm_name" == "${leader}"} {#var _igm_res 1};
	#if {$_igm_res == 0} {
		#var _igm_i 1;
		#while {$_igm_i <= &followers[]} {
			#list followers get $_igm_i follower;
			#if {"$follower" == "$_igm_name"} {#var _igm_res 1};
			#math _igm_i $_igm_i + 1;
		};
	};
	#var igm_result $_igm_res;
}

#alias {cast_group %1 %2} {
	#nop %1 = spell name (e.g., armor), %2 = minimum level threshold (use 4 for level > 4);
	#nop Casts the named spell on leader and followers (manual invocation);

	#if {$lvl > %2} {
		#if {"${leader}" != ""} {sli '%1' ${leader};} {sli '%1' $me};
		#var _i 1;
		#while {$_i <= &followers[]} {
			#list followers get $_i follower;
			#if {"$follower" != "${leader}"} {sli '%1' $follower};
			#math _i $_i + 1;
		};
	};
}

#alias {group_targeted %1} {
	#nop %1 = command verb (e.g. 'tarot');
	#nop apply to leader if set;
	#if {"${leader}" != ""} {%1 ${leader};};
	#var _i 1;
	#while {$_i <= &followers[]} {
		#list followers get $_i name;
		#if {"$name" != "${leader}"} {%1 $name};
		#math _i $_i + 1;
	};
}

#ALIAS {groupassist_exec %1} {groupassist %1 $group_combo}
#ALIAS {groupassist_group} {group_targeted groupassist_exec}
#ALIAS {set_group_combo %1} {#var {group_combo} {%1}}
#ALIAS {set_combo} {combo %0; #var {group_combo} {%0}; groupassist_group}

#nop Followers auto-report when leader reports
#if {$is_follower} {
	#ACTION {[Group] ${leader} reports:} {report}
}

#if {$is_follower} {
	#ACTION {[Group] ${leader} says, 'o %*'} {%1}
} 

#action {You are dead!  Sorry...} {
	#delay {3} {
		ret;
		#if {"$me" == "${leader}"} {group new};
	};
}

#nop ------------------ AUTOHEAL TOGGLE ------------------
#alias {autoheal_on}  {#var {autoheal_on} {1};  #showme {Autoheal ON};  #send {}}
#alias {autoheal_off} {#var {autoheal_on} {0};  #showme {Autoheal OFF}; #send {}}
#alias {autoheal}     {#if {$autoheal_on} {autoheal_off} {autoheal_on}}

#nop ------------------ GROWS ------------------
#alias {grows} {grow scar}

#nop ------------------ AUTO CURE-BLIND / REMOVE CURSE ------------------
#ACTION {You have been blinded!} {sli 'cure blind' $me}
#ACTION {Gore sprays into your eyes.*blinding you!} {sli 'cure blind' $me}
#ACTION {^SPL: %* gruesome gnaw %* DAMROLL} {#delay {1} {sli 'remove curse' $me}}