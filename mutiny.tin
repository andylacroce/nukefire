#nop =====================================================
#nop Mutiny Profile
#nop =====================================================

#nop ------------------ CORE VARIABLES ------------------
#nop Keep variables first; actions/aliases depend on these.
#VARIABLE {me} {Mutiny}
#VARIABLE {password} {REDACTED_PASSWORD}
#VARIABLE {lvl} {}
#VARIABLE {dest} {}
#VARIABLE {trackee} {}
#VARIABLE {container} {satchel}
#VARIABLE {remort_num} {764}
#nop Toggle: aloot / aloot_on / aloot_off
#VARIABLE {autoloot_on} {1}
#nop Toggle: logging / logging_on / logging_off
#VARIABLE {logging_on} {1}
#nop Toggle: tracking / tracking_on / tracking_off
#VARIABLE {tracking_on} {1}

#nop ------------------ LEVEL TRACKING ------------------
#ACTION {Lvl %1,} {#variable lvl %1}

#nop ------------------ LOAD GENERIC MODULES ------------------
#read {nukefire/looting.tin}
#read {nukefire/travel.tin}
#read {nukefire/tracking.tin}
#read {nukefire/materials.tin}
#read {nukefire/doors.tin}
#read {nukefire/remort.tin}
#read {nukefire/sleep.tin}
#read {nukefire/eq_mgmt.tin}
#read {nukefire/channels.tin}
#read {nukefire/autoloot.tin}
#read {nukefire/logging.tin}

#nop ------------------ LOAD CLASS-SPECIFIC MODULES ------------------
#read {nukefire/gypsy.tin}

#nop ------------------ AUTOSTART ------------------
#split
#session nukefire tdome.nukefire.org 4000
#action {What's your name, freejack?} {$me}
#action {Password:} {$password}
#action {*** PRESS RETURN:} {#send {}}
#action {Make your choice:} {#send {1};#send {logging_on}}
#action {Reconnecting.} {#send {logging_on}}
