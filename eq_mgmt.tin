#nop =====================================================
#nop EQUIPMENT MANAGEMENT
#nop Equipment, inventory, shopping, and upgrades
#nop =====================================================

#nop ------------------ SHOPPING / INSCRIBE ------------------
#ALIAS {auc %1 %2} {auction %1 %2}
#ALIAS {wauc} {whatsauc}
#ALIAS {bi %1} {buy inscribe %1 $me}
#ALIAS {biw %1} {rem %1;bi %1;wear %1}
#ALIAS {bu %1} {buy uninscribe %1}

#nop ------------------ SELLING / UPGRADES ------------------
#ALIAS {rs %1} {rsell %1}
#ALIAS {rsa} {addmat;rsell all}
#ALIAS {uc} {upgrade conceal conceal}
#ALIAS {ui %1} {upgrade imp %1}
#ALIAS {upe %1} {upgrade eq %1}
#ALIAS {ut %1} {upgrade tat %1}


#ALIAS {id %1} {sli 'identify' %1}

#nop ------------------ EQUIPMENT VIEW ------------------
#alias {eq} {eqdiff;equip;}

#nop ------------------ EQUIPMENT COUNT MONITOR ------------------
#var {eq_count} {0}; #var {snap_eq_count} {-1}; #var {missing_items} {};

#action {^Equipment Comparison:} {
    #var {missing_items} {};
}

#action {^All snapshot items are equipped and unchanged.} {
    #if {"$me" == "${leader}"} {#showme {All eq present.}} {tel ${leader} I have all my eq.};
}

#action {^  - Missing: \[%1\]} {
    #if {"$missing_items" == ""} {
        #var {missing_items} {%1};
    } {
        #var {missing_items} {$missing_items, %1};
    };
}

#action {You are wearing \[%1\] out of \[%*\] possible eq slots.} {
    #var {eq_count} {%1};
    #if {$snap_eq_count >= 0} {
        #if {$eq_count != $snap_eq_count} {
            #delay {1} {
                #var {mismatch_msg} {(((( EQUIPMENT MISMATCH )))): wearing $eq_count expected $snap_eq_count};
                #if {"$missing_items" != ""} {#var {mismatch_msg} {$mismatch_msg -- missing: $missing_items}};
                #if {"$me" == "${leader}"} {#showme {$mismatch_msg}} {tel ${leader} $mismatch_msg};
            };
        };
    };
}

#action {^\[Saved your re-wear script\.\]} {
    #var {snap_eq_count} $eq_count;
    #if {"$me" == "${leader}"} { #showme {Snapshot eq_count saved: $snap_eq_count} } { tel ${leader} Snapshot eq_count saved: $snap_eq_count };
}

#nop ------------------ Auction Management ------------------
#nop A small but sturdy Skynet(TM) drone drops to hover height and delivers a heavy carbon steel key.
#action {A small but sturdy Skynet\(TM\) drone drops to hover height and delivers %*\.} {
    #var {item_name} {%1};
    #replace {item_name} {^a } {};
    #replace {item_name} {^an } {};
    #var {temp_name} {$item_name};
    #replace {temp_name} { } {;};
    #list {words} {create} {$temp_name};
    #foreach {$words[]} {word} {
        give haenym $word;
        tel haenym o ps $word;
    };
}

#nop Field Tech salutes Mutiny and slaps a crate into their arms: a chitin-strung drone cloak
#action {Field Tech salutes Mutiny and slaps a crate into their arms: %*} {
    #var {item_name} {%1};
    #replace {item_name} {^a } {};
    #replace {item_name} {^an } {};
    #var {temp_name} {$item_name};
    #replace {temp_name} { } {;};
    #list {words} {create} {$temp_name};
    #foreach {$words[]} {word} {
        give haenym $word;
        tel haenym o ps $word;
    };
}   